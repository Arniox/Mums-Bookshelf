# Public GitHub Pages build values (GitHub Actions variables; never secrets)
PUBLIC_SITE_URL=https://username.github.io/repository
PUBLIC_BASE_PATH=/repository
PUBLIC_API_BASE_URL=https://author-library-api.example.workers.dev
PUBLIC_COMMENTS_ENABLED=false
PUBLIC_TURNSTILE_SITE_KEY=

# Worker values (.dev.vars locally; Wrangler vars/secrets in Cloudflare)
ALLOWED_ORIGINS=https://username.github.io
AUTH_TOKEN_ISSUER=author-library-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
JWT_SIGNING_SECRET=
PASSWORD_PEPPER=
IP_HASH_SECRET=
TURNSTILE_SECRET_KEY=
ENVIRONMENT=production

