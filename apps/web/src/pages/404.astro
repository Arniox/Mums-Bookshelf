---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Page not found"
  description="The requested page could not be found."
  noindex
>
  <section class="not-found" data-not-found hidden>
    <p class="eyebrow">404 · Mis-shelved</p>
    <h1>This story isn’t on the shelf.</h1>
    <p>The page may have moved, or perhaps it was only a first draft.</p>
    <a class="button primary" href={base}>Return to the library</a>
  </section>
</BaseLayout>

<script>
  const base = import.meta.env.BASE_URL;
  const basePath = base === "/" ? "" : base.replace(/\/$/, "");
  const workPath = window.location.pathname.slice(basePath.length);
  const match = workPath.match(/^\/works\/([a-z0-9]+(?:-[a-z0-9]+)*)\/?$/);
  if (match?.[1])
    window.location.replace(
      `${base}works/read/?work=${encodeURIComponent(match[1])}`,
    );
  else document.querySelector<HTMLElement>("[data-not-found]")!.hidden = false;
</script>
