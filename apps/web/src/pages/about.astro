---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublicSettings } from "../lib/contentSource";
const settings = await getPublicSettings();
const authorInitials = settings.authorName
  .split(/\s+/)
  .map((name) => name[0])
  .filter(Boolean)
  .slice(0, 2)
  .join("")
  .toUpperCase();
---

<BaseLayout
  title="About"
  description={`About author ${settings.authorName} and her writing.`}
  siteSettings={settings}
>
  <article class="about-page">
    <header>
      <p class="eyebrow">About the author</p>
      <h1 data-about-author-name>{settings.authorName}</h1>
    </header>
    <div class="about-layout">
      {
        settings.profileImageUrl ? (
          <figure class="author-portrait" data-about-portrait>
            <img
              src={settings.profileImageUrl}
              alt={`${settings.authorName}, author`}
              width="960"
              height="1200"
              decoding="async"
            />
          </figure>
        ) : (
          <div
            class="portrait-placeholder"
            role="img"
            aria-label={`A decorative monogram portrait placeholder for ${settings.authorName}`}
            data-about-portrait
          >
            <span>{authorInitials}</span>
            <small>Photo coming soon</small>
          </div>
        )
      }
      <div class="about-copy">
        <div data-about-biography>
          {
            settings.biography
              .split("\n\n")
              .map((paragraph) => <p>{paragraph}</p>)
          }
        </div>
        <h2>Elsewhere</h2>
        <ul class="social-list" data-about-social-links>
          {
            Object.entries(settings.socialLinks).map(([label, url]) => (
              <li>
                <a href={url}>{label} ↗</a>
              </li>
            ))
          }
          {
            settings.contactLink && (
              <li>
                <a href={settings.contactLink}>Contact ↗</a>
              </li>
            )
          }
        </ul>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import { getRuntimePublicSettings } from "../lib/runtimeContent";

  void getRuntimePublicSettings()
    .then((settings) => {
      const authorName = document.querySelector<HTMLElement>(
        "[data-about-author-name]",
      );
      if (authorName) authorName.textContent = settings.authorName;
      const portrait = document.querySelector<HTMLElement>(
        "[data-about-portrait]",
      );
      if (portrait) {
        if (settings.profileImageUrl) {
          const figure = document.createElement("figure");
          figure.className = "author-portrait";
          figure.dataset.aboutPortrait = "";
          const image = document.createElement("img");
          image.src = settings.profileImageUrl;
          image.alt = `${settings.authorName}, author`;
          image.width = 960;
          image.height = 1200;
          image.decoding = "async";
          figure.append(image);
          portrait.replaceWith(figure);
        } else {
          const placeholder = document.createElement("div");
          placeholder.className = "portrait-placeholder";
          placeholder.dataset.aboutPortrait = "";
          placeholder.setAttribute("role", "img");
          placeholder.setAttribute(
            "aria-label",
            `A decorative monogram portrait placeholder for ${settings.authorName}`,
          );
          const initials = settings.authorName
            .split(/\s+/)
            .map((name) => name[0])
            .filter(Boolean)
            .slice(0, 2)
            .join("")
            .toUpperCase();
          const mark = document.createElement("span");
          mark.textContent = initials;
          const note = document.createElement("small");
          note.textContent = "Photo coming soon";
          placeholder.append(mark, note);
          portrait.replaceWith(placeholder);
        }
      }
      const biography = document.querySelector<HTMLElement>(
        "[data-about-biography]",
      );
      if (biography) {
        biography.replaceChildren(
          ...settings.biography
            .split("\n\n")
            .filter(Boolean)
            .map((paragraph) => {
              const element = document.createElement("p");
              element.textContent = paragraph;
              return element;
            }),
        );
      }
      const links = document.querySelector<HTMLElement>(
        "[data-about-social-links]",
      );
      if (links) {
        const entries: Array<[string, string]> = [
          ...Object.entries(settings.socialLinks),
          ...(settings.contactLink
            ? ([["Contact", settings.contactLink]] as Array<[string, string]>)
            : []),
        ];
        links.replaceChildren(
          ...entries.map(([label, url]) => {
            const item = document.createElement("li");
            const link = document.createElement("a");
            link.href = url;
            link.textContent = `${label} ↗`;
            item.append(link);
            return item;
          }),
        );
      }
    })
    .catch(() => undefined);
</script>
