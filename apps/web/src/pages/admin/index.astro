---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublicSettings } from "../../lib/contentSource";

const settings = await getPublicSettings();
const authorInitials = settings.authorName
  .split(/\s+/)
  .map((name) => name[0])
  .filter(Boolean)
  .slice(0, 2)
  .join("")
  .toUpperCase();
---

<BaseLayout
  title="Author studio"
  description="Private editorial workspace."
  siteSettings={settings}
  noindex
>
  <div class="admin-shell" data-admin-app data-api={__API_BASE_URL__}>
    <section class="login-panel" data-login-panel aria-labelledby="login-title">
      <div class="login-mark" aria-hidden="true">{authorInitials}</div>
      <p class="eyebrow">Private editorial space</p>
      <h1 id="login-title">Author studio</h1>
      <p>Sign in to manage the bookshelf, stories and reader comments.</p>
      <form data-login-form>
        <label>
          <span>Username</span>
          <input name="username" autocomplete="username" required />
        </label>
        <label>
          <span>Password</span>
          <input
            name="password"
            type="password"
            autocomplete="current-password"
            minlength="8"
            required
          />
        </label>
        <button class="button primary" type="submit">Sign in</button>
        <p class="form-status" data-login-status aria-live="polite"></p>
      </form>
    </section>

    <section class="admin-studio" data-admin-studio hidden>
      <header class="admin-header">
        <div>
          <p class="eyebrow">{settings.authorName}</p>
          <h1>Author studio</h1>
        </div>
        <div class="button-row">
          <button class="button secondary" type="button" data-rebuild
            >Update public website</button
          >
          <button class="button secondary" type="button" data-export
            >Export data</button
          >
          <button class="text-button" type="button" data-logout>Sign out</button
          >
        </div>
      </header>
      <p
        class="form-status deployment-status"
        data-deployment-status
        aria-live="polite"
      >
      </p>

      <nav class="admin-tabs" aria-label="Studio sections">
        <button type="button" aria-current="page" data-tab="dashboard"
          >Dashboard</button
        >
        <button type="button" data-tab="works">Works</button>
        <button type="button" data-tab="comments">Comments</button>
        <button type="button" data-tab="settings">Site settings</button>
      </nav>

      <div data-panel="dashboard">
        <div class="dashboard-heading">
          <div>
            <p class="eyebrow">At a glance</p>
            <h2>Welcome back</h2>
          </div>
          <button class="button primary" type="button" data-new-work
            >+ Add new work</button
          >
        </div>
        <div class="stat-grid">
          <article>
            <strong data-stat-published>—</strong><span>Published</span>
          </article>
          <article>
            <strong data-stat-drafts>—</strong><span>Drafts</span>
          </article>
          <article>
            <strong data-stat-featured>—</strong><span>Featured</span>
          </article>
          <article>
            <strong data-stat-comments>—</strong><span>Awaiting review</span>
          </article>
        </div>
        <section class="admin-card">
          <h3>Recently edited</h3>
          <div data-recent-works class="admin-list"></div>
        </section>
      </div>

      <div data-panel="works" hidden>
        <div class="dashboard-heading">
          <div><p class="eyebrow">The collection</p><h2>Works</h2></div>
          <button class="button primary" type="button" data-new-work
            >+ Add new work</button
          >
        </div>
        <div class="admin-list" data-all-works></div>
      </div>

      <div data-panel="comments" hidden>
        <div class="dashboard-heading">
          <div>
            <p class="eyebrow">Reader responses</p><h2>Comment moderation</h2>
          </div>
        </div>
        <div class="admin-list" data-comments-list></div>
      </div>

      <div data-panel="settings" hidden>
        <div class="dashboard-heading">
          <div><p class="eyebrow">Public details</p><h2>Site settings</h2></div>
        </div>
        <form class="editor-form narrow" data-settings-form>
          <label
            ><span>Author name</span><input
              name="authorName"
              required
              maxlength="160"
            /></label
          >
          <label
            ><span>Introduction</span><textarea
              name="introduction"
              rows="3"
              maxlength="2000"></textarea></label
          >
          <label
            ><span>Biography <small>Markdown supported</small></span><textarea
              name="biography"
              rows="10"></textarea></label
          >
          <label
            ><span>Profile image URL</span><input
              name="profileImageUrl"
              type="url"
            /></label
          >
          <label
            ><span>Announcement</span><input
              name="announcement"
              maxlength="500"
            /></label
          >
          <label
            ><span>Contact URL</span><input
              name="contactLink"
              type="url"
            /></label
          >
          <label
            ><span
              >Social links <small>One per line: Label: https://…</small></span
            ><textarea name="socialLinks" rows="5"></textarea></label
          >
          <button class="button primary" type="submit">Save settings</button>
          <p class="form-status" data-settings-status aria-live="polite"></p>
        </form>
      </div>
    </section>
  </div>

  <dialog
    class="editor-dialog"
    data-editor-dialog
    aria-labelledby="editor-title"
  >
    <form method="dialog" class="dialog-close-row">
      <button class="icon-button" value="cancel" aria-label="Close editor"
        >×</button
      >
    </form>
    <header>
      <p class="eyebrow">Work editor</p>
      <h2 id="editor-title" data-editor-title>Add a new work</h2>
    </header>
    <form class="editor-form" data-work-form>
      <input type="hidden" name="id" />
      <div class="form-grid two">
        <label
          ><span>Title</span><input
            name="title"
            required
            maxlength="180"
          /></label
        >
        <label
          ><span>Subtitle</span><input name="subtitle" maxlength="240" /></label
        >
      </div>
      <div class="form-grid three">
        <label>
          <span>Publication type</span>
          <select name="publicationType" required>
            <option value="book">Book</option><option value="novella"
              >Novella</option
            >
            <option value="short-story">Short story</option><option value="poem"
              >Poem</option
            >
            <option value="essay">Essay</option><option value="magazine"
              >Magazine</option
            >
            <option value="anthology">Anthology</option><option value="other"
              >Other</option
            >
          </select>
        </label>
        <label
          ><span>Publication date</span><input
            name="publishedAt"
            type="date"
          /></label
        >
        <label
          ><span>Word count</span><input
            name="wordCount"
            type="number"
            min="0"
          /></label
        >
      </div>
      <label
        ><span>URL slug</span><input
          name="slug"
          required
          pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
        /></label
      >
      <label
        ><span>Blurb</span><textarea
          name="blurb"
          rows="4"
          required
          maxlength="4000"></textarea></label
      >
      <label
        ><span>Excerpt <small>Markdown supported</small></span><textarea
          name="excerpt"
          rows="7"></textarea></label
      >
      <label
        ><span>Full story <small>Markdown supported</small></span><textarea
          name="storyContent"
          rows="15"></textarea></label
      >
      <label
        ><span>Author notes <small>Markdown supported</small></span><textarea
          name="authorNotes"
          rows="6"></textarea></label
      >

      <fieldset>
        <legend>What visitors can read</legend>
        <label class="radio-card">
          <input
            type="radio"
            name="contentVisibility"
            value="external-only"
            checked
          />
          <span
            ><strong>Link only</strong><small
              >Visitors see the blurb and external link, but not the story.</small
            ></span
          >
        </label>
        <label class="radio-card">
          <input type="radio" name="contentVisibility" value="excerpt" />
          <span
            ><strong>Excerpt</strong><small
              >Visitors see the blurb and excerpt.</small
            ></span
          >
        </label>
        <label class="radio-card">
          <input type="radio" name="contentVisibility" value="full" />
          <span
            ><strong>Full story</strong><small
              >Visitors can read the complete story on the website.</small
            ></span
          >
        </label>
        <p class="visibility-warning" data-full-warning hidden>
          Only publish content here when you hold the necessary digital rights.
        </p>
      </fieldset>

      <div class="form-grid two">
        <label><span>Publisher</span><input name="publisherName" /></label>
        <label
          ><span>Publication name</span><input name="publicationName" /></label
        >
        <label
          ><span>Publication URL</span><input
            name="primaryExternalUrl"
            type="url"
          /></label
        >
        <label
          ><span>Purchase URL</span><input
            name="purchaseUrl"
            type="url"
          /></label
        >
        <label
          ><span>Social post URL</span><input
            name="socialPostUrl"
            type="url"
          /></label
        >
        <label class="checkbox"
          ><input name="socialEmbedEnabled" type="checkbox" /><span
            >Enable supported social embed</span
          ></label
        >
        <label
          ><span>Cover image URL</span><input
            name="coverImageUrl"
            type="url"
          /></label
        >
        <label
          ><span>Cover image alt text</span><input
            name="coverImageAlt"
          /></label
        >
        <label
          ><span>Genres <small>Comma separated</small></span><input
            name="genres"
          /></label
        >
        <label
          ><span>Tags <small>Comma separated</small></span><input
            name="tags"
          /></label
        >
      </div>
      <input type="hidden" name="status" value="draft" />
      <div class="form-grid two">
        <label
          ><span>Display order</span><input
            name="displayOrder"
            type="number"
          /></label
        >
        <label class="checkbox"
          ><input name="featured" type="checkbox" /><span
            >Feature this work</span
          ></label
        >
      </div>
      <div class="form-grid two">
        <label
          ><span>SEO title</span><input name="seoTitle" maxlength="70" /></label
        >
        <label
          ><span>SEO description</span><textarea
            name="seoDescription"
            rows="2"
            maxlength="180"></textarea></label
        >
      </div>
      <details class="preview-panel">
        <summary>Preview draft text</summary>
        <div data-markdown-preview class="story-content"></div>
      </details>
      <aside class="draft-safety-note">
        <strong>Your writing is protected while you edit.</strong>
        <p>
          A recovery copy is saved in this browser. Use <em
            >Save draft online</em
          >
          to continue on another device. Nothing becomes public until you choose
          <em>Publish &amp; update website</em>.
        </p>
        <p data-local-draft-status aria-live="polite"></p>
      </aside>
      <div class="editor-actions">
        <button class="button secondary" type="button" data-archive hidden
          >Archive work</button
        >
        <span class="spacer"></span>
        <button class="text-button" type="button" data-cancel-editor
          >Close</button
        >
        <button class="button secondary" type="button" data-save-local
          >Save on this device</button
        >
        <button
          class="button secondary"
          type="submit"
          data-editor-action="draft">Save draft online</button
        >
        <button
          class="button primary"
          type="submit"
          data-editor-action="publish">Publish &amp; update website</button
        >
      </div>
      <p class="form-status" data-editor-status aria-live="polite"></p>
    </form>
  </dialog>
</BaseLayout>

<script>
  import {
    localWorkDraftKey,
    parseLocalWorkDraft,
    type LocalWorkDraft,
  } from "../../lib/localDraft";

  type ApiWork = Record<string, any>;
  const app = document.querySelector<HTMLElement>("[data-admin-app]")!;
  const apiBase = app.dataset.api!;
  let accessToken = "";
  let works: ApiWork[] = [];
  let dirty = false;
  let originalStatus = "draft";
  let localSaveTimer: number | undefined;

  const request = async (path: string, init: RequestInit = {}) => {
    const headers = new Headers(init.headers);
    if (init.body) headers.set("Content-Type", "application/json");
    if (accessToken) headers.set("Authorization", `Bearer ${accessToken}`);
    const response = await fetch(`${apiBase}${path}`, {
      ...init,
      headers,
      credentials: "include",
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok)
      throw new Error(
        payload.error?.message || "The request could not be completed.",
      );
    return payload.data;
  };

  const loginPanel = document.querySelector<HTMLElement>("[data-login-panel]")!;
  const studio = document.querySelector<HTMLElement>("[data-admin-studio]")!;
  const loginStatus = document.querySelector<HTMLElement>(
    "[data-login-status]",
  )!;
  const deploymentStatus = document.querySelector<HTMLElement>(
    "[data-deployment-status]",
  )!;

  const triggerDeployment = async (status = deploymentStatus) => {
    status.textContent = "Starting the website update…";
    const deployment = await request("/api/v1/admin/deployments/pages", {
      method: "POST",
    });
    status.textContent = deployment.runId
      ? "Website update started. It should be visible in a few minutes."
      : "Website update queued. It should be visible in a few minutes.";
    return deployment;
  };
  const showStudio = () => {
    loginPanel.hidden = true;
    studio.hidden = false;
  };

  const refreshSession = async () => {
    try {
      const session = await request("/api/v1/auth/refresh", { method: "POST" });
      accessToken = session.accessToken;
      showStudio();
      await loadDashboard();
    } catch {
      loginPanel.hidden = false;
      studio.hidden = true;
    }
  };

  document
    .querySelector<HTMLFormElement>("[data-login-form]")
    ?.addEventListener("submit", async (event) => {
      event.preventDefault();
      loginStatus.textContent = "Signing in…";
      const data = Object.fromEntries(
        new FormData(event.currentTarget as HTMLFormElement),
      );
      try {
        const session = await request("/api/v1/auth/login", {
          method: "POST",
          body: JSON.stringify(data),
        });
        accessToken = session.accessToken;
        loginStatus.textContent = "";
        showStudio();
        await loadDashboard();
      } catch (error) {
        loginStatus.textContent = (error as Error).message;
      }
    });

  document
    .querySelector("[data-logout]")
    ?.addEventListener("click", async () => {
      await request("/api/v1/auth/logout", { method: "POST" }).catch(
        () => undefined,
      );
      accessToken = "";
      window.location.reload();
    });

  const escape = (value: unknown) =>
    String(value ?? "").replace(
      /[&<>"']/g,
      (character) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        })[character]!,
    );

  const workRow = (work: ApiWork) => `
    <article class="admin-list-row">
      <div>
        <strong>${escape(work.title)}</strong>
        <span>${escape(work.status)} · ${escape(work.publicationType).replace("-", " ")}</span>
      </div>
      <time>${new Date(work.updatedAt).toLocaleDateString()}</time>
      <button class="text-button" type="button" data-edit-work="${escape(work.id)}">Edit</button>
    </article>`;

  const bindEditButtons = () => {
    document
      .querySelectorAll<HTMLButtonElement>("[data-edit-work]")
      .forEach((button) => {
        button.addEventListener("click", () =>
          openEditor(works.find((work) => work.id === button.dataset.editWork)),
        );
      });
  };

  const loadDashboard = async () => {
    const [workData, commentData] = await Promise.all([
      request("/api/v1/admin/works"),
      request("/api/v1/admin/comments?status=pending"),
    ]);
    works = workData.items;
    document.querySelector<HTMLElement>("[data-stat-published]")!.textContent =
      String(works.filter((work) => work.status === "published").length);
    document.querySelector<HTMLElement>("[data-stat-drafts]")!.textContent =
      String(works.filter((work) => work.status === "draft").length);
    document.querySelector<HTMLElement>("[data-stat-featured]")!.textContent =
      String(works.filter((work) => work.featured).length);
    document.querySelector<HTMLElement>("[data-stat-comments]")!.textContent =
      String(commentData.items.length);
    document.querySelector<HTMLElement>("[data-recent-works]")!.innerHTML =
      works.slice(0, 5).map(workRow).join("");
    document.querySelector<HTMLElement>("[data-all-works]")!.innerHTML = works
      .map(workRow)
      .join("");
    renderComments(commentData.items);
    bindEditButtons();
    await loadSettings();
  };

  const renderComments = (comments: ApiWork[]) => {
    const list = document.querySelector<HTMLElement>("[data-comments-list]")!;
    list.innerHTML = comments.length
      ? comments
          .map(
            (comment) => `<article class="comment-row">
          <p>“${escape(comment.body)}”</p>
          <span>${escape(comment.display_name || "Anonymous")} on <strong>${escape(comment.work_title)}</strong></span>
          <div class="button-row">
            <button class="button secondary" data-comment-action="approved" data-comment-id="${escape(comment.id)}">Approve</button>
            <button class="text-button" data-comment-action="rejected" data-comment-id="${escape(comment.id)}">Reject</button>
          </div>
        </article>`,
          )
          .join("")
      : "<p class='empty-admin'>No comments are waiting for review.</p>";
    list
      .querySelectorAll<HTMLButtonElement>("[data-comment-action]")
      .forEach((button) => {
        button.addEventListener("click", async () => {
          await request(`/api/v1/admin/comments/${button.dataset.commentId}`, {
            method: "PATCH",
            body: JSON.stringify({
              moderationStatus: button.dataset.commentAction,
            }),
          });
          button.closest("article")?.remove();
        });
      });
  };

  document.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((tab) => {
    tab.addEventListener("click", () => {
      document
        .querySelectorAll<HTMLElement>("[data-panel]")
        .forEach((panel) => {
          panel.hidden = panel.dataset.panel !== tab.dataset.tab;
        });
      document
        .querySelectorAll<HTMLButtonElement>("[data-tab]")
        .forEach((item) => item.removeAttribute("aria-current"));
      tab.setAttribute("aria-current", "page");
    });
  });

  const dialog = document.querySelector<HTMLDialogElement>(
    "[data-editor-dialog]",
  )!;
  const workForm = document.querySelector<HTMLFormElement>("[data-work-form]")!;
  const archiveButton =
    document.querySelector<HTMLButtonElement>("[data-archive]")!;
  const editorStatus = document.querySelector<HTMLElement>(
    "[data-editor-status]",
  )!;
  const localDraftStatus = document.querySelector<HTMLElement>(
    "[data-local-draft-status]",
  )!;

  const setValue = (name: string, value: unknown) => {
    const input = workForm.elements.namedItem(name) as
      HTMLInputElement | HTMLTextAreaElement | RadioNodeList | null;
    if (!input) return;
    if (input instanceof RadioNodeList) input.value = String(value ?? "");
    else if (input instanceof HTMLInputElement && input.type === "checkbox")
      input.checked = Boolean(value);
    else input.value = String(value ?? "");
  };

  const currentDraftKey = () => {
    const id = (workForm.elements.namedItem("id") as HTMLInputElement).value;
    return localWorkDraftKey(id || undefined);
  };

  const collectLocalDraftFields = () => {
    const fields: LocalWorkDraft["fields"] = {};
    Array.from(workForm.elements).forEach((element) => {
      if (
        !(
          element instanceof HTMLInputElement ||
          element instanceof HTMLTextAreaElement ||
          element instanceof HTMLSelectElement
        ) ||
        !element.name ||
        element.name === "id" ||
        element.name === "status"
      )
        return;
      if (element instanceof HTMLInputElement && element.type === "radio") {
        if (element.checked) fields[element.name] = element.value;
      } else if (
        element instanceof HTMLInputElement &&
        element.type === "checkbox"
      ) {
        fields[element.name] = element.checked;
      } else {
        fields[element.name] = element.value;
      }
    });
    return fields;
  };

  const saveLocalDraft = (announce = false) => {
    try {
      const draft: LocalWorkDraft = {
        version: 1,
        savedAt: new Date().toISOString(),
        fields: collectLocalDraftFields(),
      };
      localStorage.setItem(currentDraftKey(), JSON.stringify(draft));
      if (announce) {
        localDraftStatus.textContent = `Recovery copy saved on this device at ${new Date(draft.savedAt).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}.`;
      }
    } catch {
      if (announce)
        localDraftStatus.textContent =
          "This browser would not allow a local recovery copy. Use Save draft online instead.";
    }
  };

  const clearLocalDraft = () => {
    try {
      localStorage.removeItem(currentDraftKey());
    } catch {
      // Saving online still succeeded when browser storage is unavailable.
    }
    localDraftStatus.textContent = "";
  };

  const openEditor = (work?: ApiWork) => {
    workForm.reset();
    editorStatus.textContent = "";
    document.querySelector<HTMLElement>("[data-editor-title]")!.textContent =
      work ? "Edit work" : "Add a new work";
    archiveButton.hidden = !work;
    const defaults: ApiWork = work || {
      publicationType: "short-story",
      status: "draft",
      contentVisibility: "external-only",
      genres: [],
      tags: [],
    };
    originalStatus = String(defaults.status || "draft");
    Object.entries(defaults).forEach(([key, value]) =>
      setValue(key, Array.isArray(value) ? value.join(", ") : value),
    );
    if (work?.publishedAt)
      setValue("publishedAt", work.publishedAt.slice(0, 10));
    (workForm.elements.namedItem("slug") as HTMLInputElement).dataset.auto =
      work ? "false" : "true";
    dirty = false;
    localDraftStatus.textContent = "";
    try {
      const localDraft = parseLocalWorkDraft(
        localStorage.getItem(localWorkDraftKey(work?.id)),
      );
      const isNewer =
        localDraft &&
        (!work?.updatedAt ||
          Date.parse(localDraft.savedAt) > Date.parse(work.updatedAt));
      if (
        isNewer &&
        confirm(
          `A recovery copy from ${new Date(localDraft.savedAt).toLocaleString()} is saved on this device. Restore it?`,
        )
      ) {
        Object.entries(localDraft.fields).forEach(([key, value]) =>
          setValue(key, value),
        );
        dirty = true;
        localDraftStatus.textContent =
          "Recovered the draft saved on this device.";
      }
    } catch {
      // Browser storage is an optional recovery layer.
    }
    updatePreview();
    dialog.showModal();
    (workForm.elements.namedItem("title") as HTMLInputElement).focus();
  };

  document
    .querySelectorAll("[data-new-work]")
    .forEach((button) => button.addEventListener("click", () => openEditor()));
  document
    .querySelector("[data-cancel-editor]")
    ?.addEventListener("click", () => {
      if (!dirty) return dialog.close();
      saveLocalDraft(true);
      if (
        confirm(
          "Close the editor? A recovery copy will remain saved on this device.",
        )
      )
        dialog.close();
    });
  dialog.addEventListener("cancel", (event) => {
    if (!dirty) return;
    saveLocalDraft(true);
    if (
      !confirm(
        "Close the editor? A recovery copy will remain saved on this device.",
      )
    )
      event.preventDefault();
  });

  workForm.addEventListener("input", () => {
    dirty = true;
    const title = workForm.elements.namedItem("title") as HTMLInputElement;
    const slug = workForm.elements.namedItem("slug") as HTMLInputElement;
    if (!slug.value || slug.dataset.auto === "true") {
      slug.value = title.value
        .toLowerCase()
        .normalize("NFKD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/['’]/g, "")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
      slug.dataset.auto = "true";
    }
    updatePreview();
    window.clearTimeout(localSaveTimer);
    localSaveTimer = window.setTimeout(() => saveLocalDraft(true), 750);
  });

  document
    .querySelector("[data-save-local]")
    ?.addEventListener("click", () => saveLocalDraft(true));

  workForm
    .querySelectorAll<HTMLInputElement>('[name="contentVisibility"]')
    .forEach((radio) => {
      radio.addEventListener("change", () => {
        document.querySelector<HTMLElement>("[data-full-warning]")!.hidden =
          radio.value !== "full" || !radio.checked;
      });
    });

  const updatePreview = () => {
    const story = (
      workForm.elements.namedItem("storyContent") as HTMLTextAreaElement
    ).value;
    const excerpt = (
      workForm.elements.namedItem("excerpt") as HTMLTextAreaElement
    ).value;
    document.querySelector<HTMLElement>("[data-markdown-preview]")!.innerHTML =
      `<p>${escape(story || excerpt || "Your preview will appear here.")
        .replace(/\n\n/g, "</p><p>")
        .replace(/\n/g, "<br>")}</p>`;
  };

  workForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const action =
      (event as SubmitEvent).submitter instanceof HTMLElement
        ? (event as SubmitEvent).submitter?.dataset.editorAction
        : "draft";
    const formData = new FormData(workForm);
    const id = String(formData.get("id") || "");
    const optional = (name: string) =>
      String(formData.get(name) || "").trim() || undefined;
    const date = optional("publishedAt");
    const payload = {
      slug: String(formData.get("slug")),
      title: String(formData.get("title")),
      subtitle: optional("subtitle"),
      status: action === "publish" ? "published" : "draft",
      publicationType: String(formData.get("publicationType")),
      publishedAt: date ? `${date}T00:00:00Z` : undefined,
      wordCount: optional("wordCount")
        ? Number(formData.get("wordCount"))
        : undefined,
      blurb: String(formData.get("blurb")),
      excerpt: optional("excerpt"),
      storyContent: optional("storyContent"),
      authorNotes: optional("authorNotes"),
      contentVisibility: String(formData.get("contentVisibility")),
      publisherName: optional("publisherName"),
      publicationName: optional("publicationName"),
      primaryExternalUrl: optional("primaryExternalUrl"),
      purchaseUrl: optional("purchaseUrl"),
      socialPostUrl: optional("socialPostUrl"),
      socialEmbedEnabled: formData.get("socialEmbedEnabled") === "on",
      coverImageUrl: optional("coverImageUrl"),
      coverImageAlt: optional("coverImageAlt"),
      genres: String(formData.get("genres") || "")
        .split(",")
        .map((value) => value.trim())
        .filter(Boolean),
      tags: String(formData.get("tags") || "")
        .split(",")
        .map((value) => value.trim())
        .filter(Boolean),
      featured: formData.get("featured") === "on",
      displayOrder: optional("displayOrder")
        ? Number(formData.get("displayOrder"))
        : undefined,
      seoTitle: optional("seoTitle"),
      seoDescription: optional("seoDescription"),
    };
    if (
      action === "publish" &&
      payload.contentVisibility === "full" &&
      !confirm(
        "This will publish the complete story for anyone to read. Confirm that you hold the digital rights.",
      )
    )
      return;
    if (
      action === "publish" &&
      !confirm(
        "Ready to publish? This will make the work public and start a website update, which normally takes a few minutes.",
      )
    )
      return;
    if (
      action === "draft" &&
      originalStatus === "published" &&
      !confirm(
        "Save this published work as a draft? It will be removed from the public website when the automatic update finishes.",
      )
    )
      return;
    const wasPublished = originalStatus === "published";
    editorStatus.textContent = "Saving…";
    try {
      await request(id ? `/api/v1/admin/works/${id}` : "/api/v1/admin/works", {
        method: id ? "PUT" : "POST",
        body: JSON.stringify(payload),
      });
      dirty = false;
      window.clearTimeout(localSaveTimer);
      clearLocalDraft();
      originalStatus = payload.status;
      await loadDashboard();
      const needsWebsiteUpdate = action === "publish" || wasPublished;
      if (needsWebsiteUpdate) {
        try {
          await triggerDeployment(editorStatus);
          editorStatus.textContent =
            action === "publish"
              ? "Published. The website update has started and should appear in a few minutes."
              : "Draft saved. The website update has started to remove the public version.";
          window.setTimeout(() => dialog.close(), 1800);
        } catch (deploymentError) {
          editorStatus.textContent = (deploymentError as Error).message;
        }
      } else {
        editorStatus.textContent =
          "Draft saved online. You can continue on another device.";
        window.setTimeout(() => dialog.close(), 1200);
      }
    } catch (error) {
      editorStatus.textContent = (error as Error).message;
    }
  });

  archiveButton.addEventListener("click", async () => {
    const id = String(new FormData(workForm).get("id") || "");
    if (
      !id ||
      !confirm(
        "Archive this work? It will disappear from the public site after the next site build.",
      )
    )
      return;
    editorStatus.textContent = "Archiving…";
    try {
      await request(`/api/v1/admin/works/${id}`, { method: "DELETE" });
      dirty = false;
      window.clearTimeout(localSaveTimer);
      clearLocalDraft();
      await loadDashboard();
      await triggerDeployment(editorStatus);
      editorStatus.textContent =
        "Archived. The website update has started and should appear in a few minutes.";
      window.setTimeout(() => dialog.close(), 1800);
    } catch (error) {
      editorStatus.textContent = (error as Error).message;
    }
  });

  const loadSettings = async () => {
    const settings = await request("/api/v1/admin/settings");
    const form = document.querySelector<HTMLFormElement>(
      "[data-settings-form]",
    )!;
    Object.entries(settings).forEach(([key, value]) => {
      const input = form.elements.namedItem(key) as
        HTMLInputElement | HTMLTextAreaElement | null;
      if (input)
        input.value =
          key === "socialLinks"
            ? Object.entries(value as Record<string, string>)
                .map(([label, url]) => `${label}: ${url}`)
                .join("\n")
            : String(value ?? "");
    });
  };

  document
    .querySelector<HTMLFormElement>("[data-settings-form]")
    ?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = new FormData(event.currentTarget as HTMLFormElement);
      const socialLinks = Object.fromEntries(
        String(form.get("socialLinks") || "")
          .split("\n")
          .map((line) => {
            const split = line.indexOf(": ");
            return split > 0
              ? [line.slice(0, split), line.slice(split + 2)]
              : null;
          })
          .filter(Boolean) as [string, string][],
      );
      const payload = {
        authorName: form.get("authorName"),
        introduction: form.get("introduction"),
        biography: form.get("biography"),
        profileImageUrl: form.get("profileImageUrl") || undefined,
        announcement: form.get("announcement") || undefined,
        contactLink: form.get("contactLink") || undefined,
        socialLinks,
        themeSettings: {},
      };
      const status = document.querySelector<HTMLElement>(
        "[data-settings-status]",
      )!;
      status.textContent = "Saving…";
      try {
        await request("/api/v1/admin/settings", {
          method: "PUT",
          body: JSON.stringify(payload),
        });
        await triggerDeployment(status);
        status.textContent =
          "Settings saved. The website update has started and should appear in a few minutes.";
      } catch (error) {
        status.textContent = (error as Error).message;
      }
    });

  document
    .querySelector("[data-rebuild]")
    ?.addEventListener("click", async () => {
      try {
        await triggerDeployment();
      } catch (error) {
        deploymentStatus.textContent = (error as Error).message;
      }
    });

  document
    .querySelector("[data-export]")
    ?.addEventListener("click", async () => {
      const data = await request("/api/v1/admin/export");
      const link = document.createElement("a");
      link.href = URL.createObjectURL(
        new Blob([JSON.stringify(data, null, 2)], { type: "application/json" }),
      );
      link.download = `author-library-${new Date().toISOString().slice(0, 10)}.json`;
      link.click();
      URL.revokeObjectURL(link.href);
    });

  window.addEventListener("beforeunload", (event) => {
    if (dirty) {
      saveLocalDraft();
      event.preventDefault();
    }
  });
  refreshSession();
</script>
