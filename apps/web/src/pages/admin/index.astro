---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublicSettings } from "../../lib/contentSource";

const settings = await getPublicSettings();
const authorInitials = settings.authorName
  .split(/\s+/)
  .map((name) => name[0])
  .filter(Boolean)
  .slice(0, 2)
  .join("")
  .toUpperCase();
---

<BaseLayout
  title="Author studio"
  description="Private editorial workspace."
  siteSettings={settings}
  noindex
>
  <div class="admin-shell" data-admin-app data-api={__API_BASE_URL__}>
    <section class="login-panel" data-login-panel aria-labelledby="login-title">
      <div class="login-mark" aria-hidden="true">{authorInitials}</div>
      <p class="eyebrow">Private editorial space</p>
      <h1 id="login-title">Author studio</h1>
      <p>Sign in to manage the bookshelf, stories and reader comments.</p>
      <form data-login-form>
        <label>
          <span>Username</span>
          <input name="username" autocomplete="username" required />
        </label>
        <label>
          <span>Password</span>
          <input
            name="password"
            type="password"
            autocomplete="current-password"
            minlength="8"
            required
          />
        </label>
        <button class="button primary" type="submit">Sign in</button>
        <p class="form-status" data-login-status aria-live="polite"></p>
      </form>
    </section>

    <section class="admin-studio" data-admin-studio hidden>
      <header class="admin-header">
        <div>
          <p class="eyebrow">{settings.authorName}</p>
          <h1>Author studio</h1>
        </div>
        <div class="button-row">
          <button class="button secondary" type="button" data-rebuild
            >Refresh SEO files</button
          >
          <button class="button secondary" type="button" data-export
            >Export data</button
          >
          <button class="text-button" type="button" data-logout>Sign out</button
          >
        </div>
      </header>
      <p
        class="form-status deployment-status"
        data-deployment-status
        aria-live="polite"
      >
      </p>
      <section
        class="deployment-progress"
        data-deployment-progress
        aria-live="polite"
        hidden
      >
        <div class="deployment-progress-heading">
          <p class="eyebrow">Making your share page</p>
          <strong data-deployment-progress-title></strong>
        </div>
        <div
          class="deployment-progress-track"
          role="progressbar"
          aria-label="Share page refresh progress"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          data-deployment-progress-bar
        >
          <span></span>
        </div>
        <p data-deployment-progress-detail></p>
      </section>

      <nav class="admin-tabs" aria-label="Studio sections">
        <button type="button" aria-current="page" data-tab="dashboard"
          >Dashboard</button
        >
        <button type="button" data-tab="works">Works</button>
        <button type="button" data-tab="comments">Comments</button>
        <button type="button" data-tab="settings">Author &amp; website</button>
      </nav>

      <div data-panel="dashboard">
        <div class="dashboard-heading">
          <div>
            <p class="eyebrow">At a glance</p>
            <h2>Welcome back</h2>
          </div>
          <div class="button-row">
            <button class="button secondary" type="button" data-publish-all
              >Publish all drafts now</button
            >
            <button class="button primary" type="button" data-new-work
              >+ Add new work</button
            >
          </div>
        </div>
        <div class="stat-grid">
          <article>
            <strong data-stat-published>—</strong><span>Published</span>
          </article>
          <article>
            <strong data-stat-drafts>—</strong><span>Drafts</span>
          </article>
          <article>
            <strong data-stat-featured>—</strong><span>Featured</span>
          </article>
          <article>
            <strong data-stat-comments>—</strong><span>Awaiting review</span>
          </article>
        </div>
        <section class="admin-card">
          <h3>All books</h3>
          <div data-recent-works class="admin-list"></div>
        </section>
      </div>

      <div data-panel="works" hidden>
        <div class="dashboard-heading">
          <div><p class="eyebrow">The collection</p><h2>Works</h2></div>
          <div class="button-row">
            <button class="button secondary" type="button" data-publish-all
              >Publish all drafts now</button
            >
            <button class="button primary" type="button" data-new-work
              >+ Add new work</button
            >
          </div>
        </div>
        <div class="admin-list" data-all-works></div>
      </div>

      <div data-panel="comments" hidden>
        <div class="dashboard-heading">
          <div>
            <p class="eyebrow">Reader responses</p><h2>Comment moderation</h2>
          </div>
        </div>
        <div class="admin-list" data-comments-list></div>
      </div>

      <div data-panel="settings" hidden>
        <div class="dashboard-heading">
          <div>
            <p class="eyebrow">Public details</p>
            <h2>Author &amp; website</h2>
            <p class="settings-intro">
              Update the words, photo, announcement and links visitors see.
              Saving refreshes the static SEO files in the background.
            </p>
          </div>
        </div>
        <form class="settings-form" data-settings-form>
          <section class="settings-card" aria-labelledby="author-profile-title">
            <div class="settings-card-heading">
              <div>
                <p class="eyebrow">Identity</p>
                <h3 id="author-profile-title">Author profile</h3>
              </div>
              <img
                class="settings-profile-preview"
                data-profile-preview
                alt="Current author profile preview"
                hidden
              />
            </div>
            <label>
              <span>Author name</span>
              <input name="authorName" required maxlength="160" />
            </label>
            <label>
              <span
                >Homepage introduction <small>A short author blurb</small></span
              >
              <textarea name="introduction" rows="3" maxlength="2000"
              ></textarea>
            </label>
            <label>
              <span>Full biography <small>Shown on the About page</small></span>
              <textarea name="biography" rows="10"></textarea>
            </label>
            <label>
              <span>Profile image URL</span>
              <input name="profileImageUrl" type="url" />
            </label>
          </section>

          <section class="settings-card" aria-labelledby="homepage-intro-title">
            <p class="eyebrow">Homepage</p>
            <h3 id="homepage-intro-title">Intro card</h3>
            <label>
              <span>Intro list <small>Shown above the title</small></span>
              <input name="homepageEyebrow" required maxlength="200" />
            </label>
            <label>
              <span>Intro title <small>Use the writing tools below</small></span
              >
              <div class="rich-story-editor homepage-heading-editor">
                <div
                  class="rich-story-toolbar"
                  role="toolbar"
                  aria-label="Homepage title formatting"
                >
                  <div class="rich-story-tool-group" aria-label="Text style">
                    <button
                      type="button"
                      data-homepage-heading-command="bold"
                      title="Make selected title words bold"
                      aria-label="Bold selected title words"><strong>B</strong></button
                    >
                    <button
                      type="button"
                      data-homepage-heading-command="italic"
                      title="Make selected title words italic"
                      aria-label="Italic selected title words"><em>I</em></button
                    >
                    <button
                      type="button"
                      data-homepage-heading-command="underline"
                      title="Underline selected title words"
                      aria-label="Underline selected title words"><u>U</u></button
                    >
                    <button
                      type="button"
                      data-homepage-heading-command="strikeThrough"
                      title="Cross out selected title words"
                      aria-label="Cross out selected title words"><s>S</s></button
                    >
                  </div>
                </div>
                <div
                  class="rich-story-canvas"
                  data-homepage-heading-editor
                  contenteditable="true"
                  role="textbox"
                  aria-multiline="true"
                  aria-label="Homepage title editor"
                >
                </div>
              </div>
              <textarea name="homepageHeadingHtml" hidden></textarea>
            </label>
          </section>

          <section class="settings-card" aria-labelledby="announcement-title">
            <p class="eyebrow">Homepage</p>
            <h3 id="announcement-title">Announcement</h3>
            <p class="settings-help">
              Use this for current news, a forthcoming book, an event or a new
              publication. Leave it blank to hide the announcement.
            </p>
            <label>
              <span>Announcement text</span>
              <textarea
                name="announcement"
                rows="4"
                maxlength="500"
                aria-describedby="announcement-count"></textarea>
              <small id="announcement-count" class="character-count">
                <span data-announcement-count>0</span>/500 characters
              </small>
            </label>
          </section>

          <section class="settings-card" aria-labelledby="links-title">
            <p class="eyebrow">Find me elsewhere</p>
            <h3 id="links-title">Contact &amp; social links</h3>
            <p class="settings-help">
              Add as many social profiles or author pages as you need. Their
              labels and links will appear on the About page.
            </p>
            <label>
              <span>Contact link</span>
              <input
                name="contactLink"
                type="url"
                placeholder="mailto:name@example.com or https://…"
              />
            </label>
            <div class="social-link-editor" data-social-links></div>
            <button
              class="text-button add-social-link"
              type="button"
              data-add-social
            >
              + Add social link
            </button>
          </section>

          <div class="settings-actions">
            <button class="button primary" type="submit">
              Save &amp; update website
            </button>
            <p class="form-status" data-settings-status aria-live="polite"></p>
          </div>
        </form>
      </div>
    </section>
  </div>

  <dialog
    class="editor-dialog"
    data-editor-dialog
    aria-labelledby="editor-title"
  >
    <form method="dialog" class="dialog-close-row">
      <button class="icon-button" value="cancel" aria-label="Close editor"
        >×</button
      >
    </form>
    <header>
      <p class="eyebrow">Work editor</p>
      <h2 id="editor-title" data-editor-title>Add a new work</h2>
    </header>
    <form class="editor-form" data-work-form>
      <input type="hidden" name="id" />
      <input type="hidden" name="updatedAt" />
      <p class="required-note"><abbr title="required">*</abbr> Required</p>
      <label
        ><span>Title <abbr title="required">*</abbr></span><input
          name="title"
          required
          maxlength="180"
        /></label
      >
      <div class="form-grid three">
        <label>
          <span>Publication type <abbr title="required">*</abbr></span>
          <select name="publicationType" required>
            <option value="book">Book</option><option value="novella"
              >Novella</option
            >
            <option value="short-story">Short story</option><option value="poem"
              >Poem</option
            >
            <option value="essay">Essay</option><option value="magazine"
              >Magazine</option
            >
            <option value="anthology">Anthology</option><option value="other"
              >Other</option
            >
          </select>
        </label>
        <label
          ><span
            >Publication date <abbr title="required when publishing">*</abbr
            ><small>Required when publishing</small></span
          ><input name="publishedAt" type="date" /></label
        >
        <label
          ><span>Word count</span><input
            name="wordCount"
            type="number"
            min="0"
          /></label
        >
      </div>
      <label
        ><span>URL slug <abbr title="required">*</abbr></span><input
          name="slug"
          required
          pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
        /></label
      >
      <label
        ><span>Blurb <abbr title="required">*</abbr></span><textarea
          name="blurb"
          rows="4"
          required
          maxlength="4000"></textarea></label
      >
      <div data-full-story-field>
        <span
          >Full story <abbr title="required when Full Story is selected">*</abbr
          ><small
            >Paste directly from Word, then refine it here with the writing
            tools. Your original formatting is kept where the website supports
            it; required for Full Story.</small
          ></span
        ><div class="rich-story-editor" data-rich-story-editor>
          <div
            class="rich-story-toolbar"
            role="toolbar"
            aria-label="Story formatting"
          >
            <div class="rich-story-tool-group" aria-label="Text style">
              <button type="button" data-story-command="bold" title="Make selected words bold" aria-label="Bold selected words"><strong>B</strong></button>
              <button type="button" data-story-command="italic" title="Make selected words italic" aria-label="Italic selected words"><em>I</em></button>
              <button type="button" data-story-command="underline" title="Underline selected words" aria-label="Underline selected words"><u>U</u></button>
              <button type="button" data-story-command="strikeThrough" title="Cross out selected words" aria-label="Cross out selected words"><s>S</s></button>
            </div>
            <div class="rich-story-tool-group" aria-label="Structure">
              <button type="button" data-story-transform="h2" title="Turn this into a chapter heading" aria-label="Chapter heading">H2</button>
              <button type="button" data-story-list="ul" title="Start a bullet list" aria-label="Bullet list">UL</button>
              <button type="button" data-story-list="ol" title="Start a numbered list" aria-label="Numbered list">OL</button>
              <button type="button" data-story-indent="in" title="Move this paragraph in" aria-label="Indent paragraph">&gt;</button>
              <button type="button" data-story-indent="out" title="Move this paragraph out" aria-label="Outdent paragraph">&lt;</button>
            </div>
            <div class="rich-story-tool-group" aria-label="Story details">
              <button type="button" data-story-drop-cap title="Toggle a large opening character for the selected text" aria-label="Toggle drop cap for selected text">Aa</button>
              <button type="button" data-story-pause title="Add an editable story pause" aria-label="Scene break">***</button>
            </div>
          </div>
          <div
            class="rich-story-canvas"
            data-story-editor
            contenteditable="true"
            role="textbox"
            aria-multiline="true"
            aria-label="Full story editor"
          >
          </div>
        </div>
        <textarea name="storyContent" rows="15" hidden></textarea>
      </div>

      <fieldset>
        <legend>
          What visitors can read <abbr title="required">*</abbr>
        </legend>
        <label class="radio-card">
          <input
            type="radio"
            name="contentVisibility"
            value="external-only"
            required
            checked
          />
          <span
            ><strong>Link only</strong><small
              >Visitors see the blurb and external link, but not the story.</small
            ></span
          >
        </label>
        <label class="radio-card">
          <input type="radio" name="contentVisibility" value="full" />
          <span
            ><strong>Full story</strong><small
              >Visitors can read the complete story on the website.</small
            ></span
          >
        </label>
        <p class="visibility-warning" data-full-warning hidden>
          Only publish content here when you hold the necessary digital rights.
        </p>
      </fieldset>

      <div class="form-grid two link-fields">
        <label
          ><span
            >Publisher <small>Include the publication name here too</small
            ></span
          ><input name="publisherName" /></label
        >
        <label
          ><span
            >Publication URL <abbr title="required for Link Only">*</abbr><small
              class="field-help"
              >The original post from the publication that published your story.
              Required when using Link Only.</small
            ></span
          ><input name="primaryExternalUrl" type="url" /></label
        >
        <label
          ><span
            >Audio URL <small class="field-help"
              >Optional. A link to a podcast, audiobook or other audio version,
              if one has been made.</small
            ></span
          ><input name="audioUrl" type="url" /></label
        >
        <label
          ><span
            >Purchase URL <small class="field-help"
              >Optional. Where readers can buy the physical book or purchase a
              subscription to access the story. It is okay if this is the same
              as the Publication URL.</small
            ></span
          ><input name="purchaseUrl" type="url" /><small
            class="matching-url-note"
            data-matching-url-note
            hidden
            >These URLs match. Visitors will see one “View this work” button.</small
          ></label
        >
        <label
          ><span
            >Social media post URL <small class="field-help"
              >Optional. A link to your own social media post announcing that
              the story was published.</small
            ></span
          ><input name="socialPostUrl" type="url" /></label
        >
        <label class="checkbox"
          ><input name="socialEmbedEnabled" type="checkbox" /><span
            >Enable supported social embed</span
          ></label
        >
        <label
          ><span>Work image URL <small>Optional</small></span><input
            name="workImageUrl"
            type="url"
          /></label
        >
        <label
          ><span>Genres <small>Comma separated</small></span><input
            name="genres"
          /></label
        >
      </div>
      <input type="hidden" name="status" value="draft" />
      <label class="checkbox"
        ><input name="featured" type="checkbox" /><span
          >Feature this work <small>Featured work stays at the top</small></span
        ></label
      >
      <details class="preview-panel">
        <summary>Preview draft text</summary>
        <div data-markdown-preview class="story-content"></div>
      </details>
      <aside class="draft-safety-note">
        <strong>Your writing is protected while you edit.</strong>
        <p>
          A recovery copy is saved in this browser. Use <em>Save online</em>
          to continue on another device. Nothing becomes public until you choose
          <em>Publish now</em>.
        </p>
        <p data-local-draft-status aria-live="polite"></p>
      </aside>
      <details data-work-history hidden>
        <summary>Change history</summary>
        <div class="admin-list" data-work-history-list></div>
      </details>
      <div class="editor-actions">
        <button class="button secondary" type="button" data-archive hidden
          >Archive work</button
        >
        <span class="spacer"></span>
        <button class="text-button" type="button" data-cancel-editor
          >Close</button
        >
        <button class="button secondary" type="button" data-save-local
          >Save on this device</button
        >
        <button class="button secondary" type="submit" data-editor-action="save"
          >Save online</button
        >
        <button
          class="button primary"
          type="submit"
          data-editor-action="publish">Publish now</button
        >
      </div>
      <p class="form-status" data-editor-status aria-live="polite"></p>
    </form>
  </dialog>
</BaseLayout>

<script>
  import { areSameExternalUrls } from "@mums-bookshelf/shared";
  import {
    localWorkDraftKey,
    parseLocalWorkDraft,
    type LocalWorkDraft,
  } from "../../lib/localDraft";
  import {
    hasStructuredStoryHtml,
    normaliseStoryHtml,
    storyTextToEditorHtml,
    wordHtmlToStoryHtml,
  } from "../../lib/wordPaste";

  type ApiWork = Record<string, any>;
  interface ApiComment {
    id: string;
    display_name?: string;
    body: string;
    work_title: string;
    moderation_status: "pending" | "approved" | "rejected";
    created_at: string;
  }

  const app = document.querySelector<HTMLElement>("[data-admin-app]")!;
  const apiBase = app.dataset.api!;
  let accessToken = "";
  let works: ApiWork[] = [];
  let dirty = false;
  let originalStatus = "draft";
  let localSaveTimer: number | undefined;
  let workSaveInFlight = false;

  const request = async (path: string, init: RequestInit = {}) => {
    const headers = new Headers(init.headers);
    if (init.body) headers.set("Content-Type", "application/json");
    if (accessToken) headers.set("Authorization", `Bearer ${accessToken}`);
    const response = await fetch(`${apiBase}${path}`, {
      ...init,
      headers,
      credentials: "include",
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok)
      throw new Error(
        payload.error?.message || "The request could not be completed.",
      );
    return payload.data;
  };

  const setButtonBusy = (button: HTMLButtonElement, busy: boolean) => {
    button.classList.toggle("is-loading", busy);
    button.setAttribute("aria-busy", String(busy));
  };

  const loginPanel = document.querySelector<HTMLElement>("[data-login-panel]")!;
  const studio = document.querySelector<HTMLElement>("[data-admin-studio]")!;
  const loginStatus = document.querySelector<HTMLElement>(
    "[data-login-status]",
  )!;
  const deploymentStatus = document.querySelector<HTMLElement>(
    "[data-deployment-status]",
  )!;
  const publishAllButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-publish-all]"),
  );
  const deploymentProgress = document.querySelector<HTMLElement>(
    "[data-deployment-progress]",
  )!;
  const deploymentProgressTitle = document.querySelector<HTMLElement>(
    "[data-deployment-progress-title]",
  )!;
  const deploymentProgressDetail = document.querySelector<HTMLElement>(
    "[data-deployment-progress-detail]",
  )!;
  const deploymentProgressBar = document.querySelector<HTMLElement>(
    "[data-deployment-progress-bar]",
  )!;
  let deploymentPollTimer: number | undefined;
  let deploymentSince = "";
  let highestDeploymentProgress = 0;

  const deploymentMessages = {
    starting: {
      progress: 15,
      title: "Tucking the new page into place…",
      detail: "The book is already visible on the website.",
    },
    queued: {
      progress: 35,
      title: "The page is waiting its turn…",
      detail:
        "The book is already on the shelf while we get its own little page ready.",
    },
    waiting: {
      progress: 40,
      title: "The workshop is opening its doors…",
      detail:
        "The book is already live while the page-making queue gets moving.",
    },
    packing: {
      progress: 46,
      title: "Packing the pencils and paper…",
      detail: "Getting the website tools ready. This is usually a quick one.",
    },
    tidying: {
      progress: 52,
      title: "Checking the commas are behaving…",
      detail: "Making sure the website files are neat before we send them out.",
    },
    checking: {
      progress: 60,
      title: "Giving everything a careful once-over…",
      detail:
        "Testing the shelves and polishing the little details. This can take a moment.",
    },
    building: {
      progress: 64,
      title: "The page-making machine is humming along…",
      detail:
        "GitHub is working through the details. We will show the next step as soon as it tells us.",
    },
    testing: {
      progress: 68,
      title: "Making sure nothing has fallen off the shelf…",
      detail: "The website is being tested before it goes out into the world.",
    },
    binding: {
      progress: 73,
      title: "Binding the library together…",
      detail: "Putting the shared bits in their proper places.",
    },
    "building-api": {
      progress: 78,
      title: "Waking up the library helper…",
      detail:
        "Preparing the little service that keeps the bookshelf up to date.",
    },
    filing: {
      progress: 82,
      title: "Filing the newest notes in the library…",
      detail: "Checking the book records are ready for the updated site.",
    },
    "sending-api": {
      progress: 86,
      title: "Sending the librarian to work…",
      detail: "Updating the behind-the-scenes helper. Nearly there.",
    },
    "building-pages": {
      progress: 91,
      title: "Printing the fresh share pages…",
      detail:
        "Making the page people see when they open or share this book's link.",
    },
    "packing-pages": {
      progress: 95,
      title: "Wrapping the pages for delivery…",
      detail: "The new site is packed up and heading to the bookshelf.",
    },
    "deploy-waiting": {
      progress: 96,
      title: "The delivery van is at the door…",
      detail:
        "The checks are finished. GitHub is waiting for its final turn to place the new pages on the shelf.",
    },
    deploying: {
      progress: 98,
      title: "Placing the new pages on the shelf…",
      detail: "The final delivery is happening now. Just a few more moments.",
    },
    ready: {
      progress: 100,
      title: "This book now has its own page, ready to share.",
      detail: "Its share preview, RSS and sitemap are all up to date too.",
    },
    failed: {
      progress: 100,
      title: "This refresh needs a little help.",
      detail:
        "The book is still visible on the website. Try Refresh SEO files again later.",
    },
  };

  const showDeploymentProgress = (stage: keyof typeof deploymentMessages) => {
    const message = deploymentMessages[stage];
    if (message.progress < highestDeploymentProgress) return;
    highestDeploymentProgress = message.progress;
    deploymentProgress.hidden = false;
    deploymentProgressTitle.textContent = message.title;
    deploymentProgressDetail.textContent = message.detail;
    deploymentProgressBar.setAttribute(
      "aria-valuenow",
      String(message.progress),
    );
    deploymentProgressBar.dataset.state = stage;
    deploymentProgressBar.firstElementChild?.setAttribute(
      "style",
      `width: ${message.progress}%`,
    );
  };

  const checkDeploymentProgress = async () => {
    try {
      const query = deploymentSince
        ? `?since=${encodeURIComponent(deploymentSince)}`
        : "";
      const deployment = await request(
        `/api/v1/admin/deployments/pages${query}`,
      );
      if (deployment.state === "idle") return;
      const stage = deployment.stage || deployment.state;
      showDeploymentProgress(stage);
      if (deployment.state === "ready") deploymentStatus.textContent = "";
      if (
        deployment.state === "starting" ||
        deployment.state === "queued" ||
        deployment.state === "building"
      ) {
        window.clearTimeout(deploymentPollTimer);
        deploymentPollTimer = window.setTimeout(checkDeploymentProgress, 8_000);
      }
    } catch {
      showDeploymentProgress("failed");
    }
  };

  const trackDeployment = (requestedAt: string) => {
    deploymentSince = requestedAt;
    highestDeploymentProgress = 0;
    window.clearTimeout(deploymentPollTimer);
    showDeploymentProgress("starting");
    deploymentPollTimer = window.setTimeout(checkDeploymentProgress, 2_000);
  };

  const triggerDeployment = async (status = deploymentStatus) => {
    status.textContent = "Starting the background SEO refresh…";
    const deployment = await request("/api/v1/admin/deployments/pages", {
      method: "POST",
    });
    trackDeployment(deployment.requestedAt);
    status.textContent = deployment.runId
      ? "SEO refresh started. Static pages, RSS and sitemap will update in a few minutes."
      : "SEO refresh queued. Static pages, RSS and sitemap will update in a few minutes.";
    return deployment;
  };
  const showStudio = () => {
    loginPanel.hidden = true;
    studio.hidden = false;
  };

  const showLogin = (message = "") => {
    accessToken = "";
    loginPanel.hidden = false;
    studio.hidden = true;
    loginStatus.textContent = message;
  };

  const openStudio = async (session: { accessToken: string }) => {
    accessToken = session.accessToken;
    showStudio();
    deploymentStatus.textContent = "Loading the bookshelf…";
    try {
      await loadDashboard();
      deploymentStatus.textContent = "";
      void checkDeploymentProgress();
    } catch (error) {
      deploymentStatus.textContent = `You are signed in, but the bookshelf could not be loaded. ${(error as Error).message} Refresh the page to try again.`;
    }
  };

  const refreshSession = async () => {
    try {
      const session = await request("/api/v1/auth/refresh", { method: "POST" });
      await openStudio(session);
    } catch (error) {
      showLogin(
        (error as Error).message === "Session is invalid or expired."
          ? ""
          : `The author studio could not be reached. ${(error as Error).message}`,
      );
    }
  };

  document
    .querySelector<HTMLFormElement>("[data-login-form]")
    ?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submitButton = (event as SubmitEvent)
        .submitter as HTMLButtonElement | null;
      loginStatus.textContent = "Signing in…";
      const data = Object.fromEntries(
        new FormData(event.currentTarget as HTMLFormElement),
      );
      if (submitButton) {
        setButtonBusy(submitButton, true);
        submitButton.disabled = true;
      }
      try {
        const session = await request("/api/v1/auth/login", {
          method: "POST",
          body: JSON.stringify(data),
        });
        loginStatus.textContent = "";
        await openStudio(session);
      } catch (error) {
        loginStatus.textContent = (error as Error).message;
      } finally {
        if (submitButton) {
          setButtonBusy(submitButton, false);
          submitButton.disabled = false;
        }
      }
    });

  document
    .querySelector("[data-logout]")
    ?.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      setButtonBusy(button, true);
      button.disabled = true;
      try {
        await request("/api/v1/auth/logout", { method: "POST" }).catch(
          () => undefined,
        );
        accessToken = "";
        window.location.reload();
      } finally {
        setButtonBusy(button, false);
        button.disabled = false;
      }
    });

  const escape = (value: unknown) =>
    String(value ?? "").replace(
      /[&<>"']/g,
      (character) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        })[character]!,
    );

  const workRow = (work: ApiWork) => `
    <article class="admin-list-row">
      <div>
        <strong>${escape(work.title)}${work.featured ? ' <span class="featured-work-badge">Featured</span>' : ""}</strong>
        <span>${escape(work.status)} · ${escape(work.publicationType).replace("-", " ")}</span>
      </div>
      <time>${new Date(work.updatedAt).toLocaleDateString()}</time>
      <button class="text-button" type="button" data-edit-work="${escape(work.id)}">Edit</button>
    </article>`;

  const bindEditButtons = () => {
    document
      .querySelectorAll<HTMLButtonElement>("[data-edit-work]")
      .forEach((button) => {
        button.addEventListener("click", () =>
          openEditor(works.find((work) => work.id === button.dataset.editWork)),
        );
      });
  };

  const loadDashboard = async () => {
    const [workData, commentData] = await Promise.all([
      request("/api/v1/admin/works"),
      request("/api/v1/admin/comments?status=all"),
    ]);
    works = workData.items;
    const draftCount = works.filter((work) => work.status === "draft").length;
    publishAllButtons.forEach((button) => {
      button.disabled = draftCount === 0;
      button.textContent = draftCount
        ? `Publish all ${draftCount} ${draftCount === 1 ? "draft" : "drafts"} now`
        : "No drafts to publish";
    });
    document.querySelector<HTMLElement>("[data-stat-published]")!.textContent =
      String(works.filter((work) => work.status === "published").length);
    document.querySelector<HTMLElement>("[data-stat-drafts]")!.textContent =
      String(works.filter((work) => work.status === "draft").length);
    document.querySelector<HTMLElement>("[data-stat-featured]")!.textContent =
      String(works.filter((work) => work.featured).length);
    document.querySelector<HTMLElement>("[data-stat-comments]")!.textContent =
      String(
        commentData.items.filter(
          (comment: ApiComment) => comment.moderation_status === "pending",
        ).length,
      );
    document.querySelector<HTMLElement>("[data-recent-works]")!.innerHTML =
      works.map(workRow).join("");
    document.querySelector<HTMLElement>("[data-all-works]")!.innerHTML = works
      .map(workRow)
      .join("");
    renderComments(commentData.items);
    bindEditButtons();
    await loadSettings();
  };

  publishAllButtons.forEach((button) =>
    button.addEventListener("click", async () => {
      const draftCount = works.filter((work) => work.status === "draft").length;
      if (!draftCount) return;
      if (
        !confirm(
          `Publish all ${draftCount} ${draftCount === 1 ? "draft" : "drafts"}? They will appear on the website immediately. Drafts without a publication date will use today, and a background SEO refresh will follow.`,
        )
      )
        return;

      publishAllButtons.forEach((publishButton) => {
        publishButton.disabled = true;
        setButtonBusy(publishButton, true);
      });
      deploymentStatus.textContent = "Publishing all drafts…";
      try {
        const result = await request("/api/v1/admin/works/publish-all", {
          method: "POST",
        });
        await loadDashboard();
        if (!result.published) {
          deploymentStatus.textContent = "There were no drafts to publish.";
          return;
        }
        try {
          await triggerDeployment(deploymentStatus);
          deploymentStatus.textContent = `${result.published} ${result.published === 1 ? "work" : "works"} published and visible now. Static SEO files will refresh in the background.`;
        } catch (deploymentError) {
          deploymentStatus.textContent = `${result.published} ${result.published === 1 ? "work" : "works"} published and visible now. ${(deploymentError as Error).message}`;
        }
      } catch (error) {
        deploymentStatus.textContent = (error as Error).message;
        publishAllButtons.forEach((publishButton) => {
          publishButton.disabled = false;
        });
      } finally {
        publishAllButtons.forEach((publishButton) =>
          setButtonBusy(publishButton, false),
        );
      }
    }),
  );

  const renderComments = (comments: ApiComment[]) => {
    const list = document.querySelector<HTMLElement>("[data-comments-list]")!;
    list.innerHTML = comments.length
      ? comments
          .map(
            (comment) => `<article class="comment-row">
          <p>“${escape(comment.body)}”</p>
          <span>${escape(comment.display_name || "Anonymous")} on <strong>${escape(comment.work_title)}</strong> · ${new Date(comment.created_at).toLocaleDateString()}</span>
          <span class="comment-status">${escape(comment.moderation_status)}</span>
          <div class="button-row">
            ${comment.moderation_status !== "approved" ? `<button class="button secondary" data-comment-action="approved" data-comment-id="${escape(comment.id)}">Approve</button>` : ""}
            ${comment.moderation_status !== "rejected" ? `<button class="text-button" data-comment-action="rejected" data-comment-id="${escape(comment.id)}">Reject</button>` : ""}
            <button class="text-button" data-comment-action="delete" data-comment-id="${escape(comment.id)}">Delete</button>
          </div>
        </article>`,
          )
          .join("")
      : "<p class='empty-admin'>No reader comments yet.</p>";
    list
      .querySelectorAll<HTMLButtonElement>("[data-comment-action]")
      .forEach((button) => {
        button.addEventListener("click", async () => {
          setButtonBusy(button, true);
          button.disabled = true;
          try {
            const path = `/api/v1/admin/comments/${button.dataset.commentId}`;
            if (button.dataset.commentAction === "delete") {
              await request(path, { method: "DELETE" });
            } else {
              await request(path, {
                method: "PATCH",
                body: JSON.stringify({
                  moderationStatus: button.dataset.commentAction,
                }),
              });
            }
            await loadDashboard();
          } finally {
            setButtonBusy(button, false);
            button.disabled = false;
          }
        });
      });
  };

  document.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((tab) => {
    tab.addEventListener("click", () => {
      document
        .querySelectorAll<HTMLElement>("[data-panel]")
        .forEach((panel) => {
          panel.hidden = panel.dataset.panel !== tab.dataset.tab;
        });
      document
        .querySelectorAll<HTMLButtonElement>("[data-tab]")
        .forEach((item) => item.removeAttribute("aria-current"));
      tab.setAttribute("aria-current", "page");
    });
  });

  const dialog = document.querySelector<HTMLDialogElement>(
    "[data-editor-dialog]",
  )!;
  const workForm = document.querySelector<HTMLFormElement>("[data-work-form]")!;
  const archiveButton =
    document.querySelector<HTMLButtonElement>("[data-archive]")!;
  const editorStatus = document.querySelector<HTMLElement>(
    "[data-editor-status]",
  )!;
  const localDraftStatus = document.querySelector<HTMLElement>(
    "[data-local-draft-status]",
  )!;
  const workHistory = document.querySelector<HTMLElement>(
    "[data-work-history]",
  )!;
  const workHistoryList = document.querySelector<HTMLElement>(
    "[data-work-history-list]",
  )!;
  const storyEditor = document.querySelector<HTMLElement>(
    "[data-story-editor]",
  )!;
  const fullStoryField = workForm.elements.namedItem(
    "storyContent",
  ) as HTMLTextAreaElement;

  const setValue = (name: string, value: unknown) => {
    const input = workForm.elements.namedItem(name) as
      HTMLInputElement | HTMLTextAreaElement | RadioNodeList | null;
    if (!input) return;
    if (input instanceof RadioNodeList) input.value = String(value ?? "");
    else if (input instanceof HTMLInputElement && input.type === "checkbox")
      input.checked = Boolean(value);
    else input.value = String(value ?? "");
    if (name === "storyContent") {
      storyEditor.innerHTML = ensureStoryDropCap(
        storyTextToEditorHtml(String(value ?? ""), document),
      );
    }
  };

  const firstStoryParagraph = () =>
    Array.from(storyEditor.children).find(
      (element) =>
        element.tagName === "P" && element.dataset.sceneBreak !== "true",
    ) as HTMLElement | undefined;

  const ensureStoryDropCap = (html: string) => {
    const template = document.createElement("template");
    template.innerHTML = normaliseStoryHtml(html, document);
    if (template.content.querySelector("[data-drop-cap='true']"))
      return template.innerHTML;
    const paragraph = Array.from(template.content.children).find(
      (element) =>
        element.tagName === "P" && element.getAttribute("data-scene-break") !== "true",
    );
    if (!paragraph) return template.innerHTML;
    const textNodes = document.createTreeWalker(paragraph, NodeFilter.SHOW_TEXT);
    let textNode = textNodes.nextNode() as Text | null;
    while (textNode) {
      const index = textNode.data.search(/\S/u);
      if (index >= 0) {
        const characters = Array.from(textNode.data.slice(index));
        const firstCharacter = characters.shift();
        if (!firstCharacter) return template.innerHTML;
        const marker = document.createElement("span");
        marker.dataset.dropCap = "true";
        marker.textContent = firstCharacter;
        textNode.replaceWith(
          document.createTextNode(textNode.data.slice(0, index)),
          marker,
          document.createTextNode(characters.join("")),
        );
        break;
      }
      textNode = textNodes.nextNode() as Text | null;
    }
    return template.innerHTML;
  };

  const currentDraftKey = () => {
    const id = (workForm.elements.namedItem("id") as HTMLInputElement).value;
    return localWorkDraftKey(id || undefined);
  };

  const collectLocalDraftFields = () => {
    const fields: LocalWorkDraft["fields"] = {};
    Array.from(workForm.elements).forEach((element) => {
      if (
        !(
          element instanceof HTMLInputElement ||
          element instanceof HTMLTextAreaElement ||
          element instanceof HTMLSelectElement
        ) ||
        !element.name ||
        element.name === "id" ||
        element.name === "status" ||
        element.name === "updatedAt"
      )
        return;
      if (element instanceof HTMLInputElement && element.type === "radio") {
        if (element.checked) fields[element.name] = element.value;
      } else if (
        element instanceof HTMLInputElement &&
        element.type === "checkbox"
      ) {
        fields[element.name] = element.checked;
      } else {
        fields[element.name] = element.value;
      }
    });
    return fields;
  };

  const saveLocalDraft = (announce = false) => {
    try {
      const draft: LocalWorkDraft = {
        version: 1,
        savedAt: new Date().toISOString(),
        fields: collectLocalDraftFields(),
      };
      localStorage.setItem(currentDraftKey(), JSON.stringify(draft));
      if (announce) {
        localDraftStatus.textContent = `Recovery copy saved on this device at ${new Date(draft.savedAt).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}.`;
      }
    } catch {
      if (announce)
        localDraftStatus.textContent =
          "This browser would not allow a local recovery copy. Use Save draft online instead.";
    }
  };

  const clearLocalDraft = () => {
    try {
      localStorage.removeItem(currentDraftKey());
    } catch {
      // Saving online still succeeded when browser storage is unavailable.
    }
    localDraftStatus.textContent = "";
  };

  const loadWorkHistory = async (id?: string) => {
    workHistory.hidden = !id;
    workHistoryList.textContent = "";
    if (!id) return;
    try {
      const history = await request(`/api/v1/admin/works/${id}/history`);
      workHistoryList.innerHTML = history.items.length
        ? history.items
            .map(
              (entry: {
                action: string;
                actor_username: string;
                occurred_at: string;
              }) =>
                `<p>${escape(entry.action)} by ${escape(entry.actor_username)} on ${new Date(entry.occurred_at).toLocaleString()}</p>`,
            )
            .join("")
        : "<p>No recorded changes yet.</p>";
    } catch {
      workHistoryList.textContent = "Change history could not be loaded.";
    }
  };

  const openEditor = (work?: ApiWork) => {
    workForm.reset();
    storyEditor.innerHTML = "";
    fullStoryField.value = "";
    editorStatus.textContent = "";
    document.querySelector<HTMLElement>("[data-editor-title]")!.textContent =
      work ? "Edit work" : "Add a new work";
    archiveButton.hidden = !work;
    const defaults: ApiWork = work || {
      publicationType: "short-story",
      status: "draft",
      contentVisibility: "external-only",
      genres: [],
    };
    originalStatus = String(defaults.status || "draft");
    Object.entries(defaults).forEach(([key, value]) =>
      setValue(key, Array.isArray(value) ? value.join(", ") : value),
    );
    if (work?.publishedAt)
      setValue("publishedAt", work.publishedAt.slice(0, 10));
    (workForm.elements.namedItem("slug") as HTMLInputElement).dataset.auto =
      work ? "false" : "true";
    dirty = false;
    localDraftStatus.textContent = "";
    try {
      const localDraft = parseLocalWorkDraft(
        localStorage.getItem(localWorkDraftKey(work?.id)),
      );
      const isNewer =
        localDraft &&
        (!work?.updatedAt ||
          Date.parse(localDraft.savedAt) > Date.parse(work.updatedAt));
      if (
        isNewer &&
        confirm(
          `A recovery copy from ${new Date(localDraft.savedAt).toLocaleString()} is saved on this device. Restore it?`,
        )
      ) {
        Object.entries(localDraft.fields).forEach(([key, value]) =>
          setValue(key, value),
        );
        dirty = true;
        localDraftStatus.textContent =
          "Recovered the draft saved on this device.";
      }
    } catch {
      // Browser storage is an optional recovery layer.
    }
    updateVisibilityRequirements();
    updatePreview();
    dialog.showModal();
    void loadWorkHistory(work?.id);
    (workForm.elements.namedItem("title") as HTMLInputElement).focus();
  };

  document
    .querySelectorAll("[data-new-work]")
    .forEach((button) => button.addEventListener("click", () => openEditor()));
  document
    .querySelector("[data-cancel-editor]")
    ?.addEventListener("click", () => {
      if (!dirty) return dialog.close();
      saveLocalDraft(true);
      if (
        confirm(
          "Close the editor? A recovery copy will remain saved on this device.",
        )
      )
        dialog.close();
    });
  dialog.addEventListener("cancel", (event) => {
    if (!dirty) return;
    saveLocalDraft(true);
    if (
      !confirm(
        "Close the editor? A recovery copy will remain saved on this device.",
      )
    )
      event.preventDefault();
  });

  workForm.addEventListener("input", () => {
    dirty = true;
    updateVisibilityRequirements();
    const title = workForm.elements.namedItem("title") as HTMLInputElement;
    const slug = workForm.elements.namedItem("slug") as HTMLInputElement;
    if (!slug.value || slug.dataset.auto === "true") {
      slug.value = title.value
        .toLowerCase()
        .normalize("NFKD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/['’]/g, "")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
      slug.dataset.auto = "true";
    }
    updatePreview();
    window.clearTimeout(localSaveTimer);
    localSaveTimer = window.setTimeout(() => saveLocalDraft(true), 750);
  });

  const updateStoryPauseMarkers = () => {
    storyEditor
      .querySelectorAll<HTMLParagraphElement>("p")
      .forEach((paragraph) => {
        if (/^#{2,}$/u.test(paragraph.textContent?.trim() || ""))
          paragraph.dataset.sceneBreak = "true";
        else delete paragraph.dataset.sceneBreak;
      });
  };

  const syncStoryEditor = (normalise = false) => {
    if (normalise) storyEditor.innerHTML = ensureStoryDropCap(storyEditor.innerHTML);
    updateStoryPauseMarkers();
    fullStoryField.value = storyEditor.innerHTML.trim();
    fullStoryField.dispatchEvent(new Event("input", { bubbles: true }));
  };
  const executeRichTextCommand = (command: string, value?: string) => {
    const execCommand = Reflect.get(document, "execCommand") as (
      this: Document,
      commandId: string,
      showUi?: boolean,
      value?: string,
    ) => boolean;
    return execCommand.call(document, command, false, value);
  };

  const notifyRichTextChange = (editor: HTMLElement) =>
    editor.dispatchEvent(new Event("input", { bubbles: true }));

  const captureEditorSelection = (editor: HTMLElement) => {
    const selection = window.getSelection();
    if (!selection?.rangeCount || !editor.contains(selection.anchorNode))
      return undefined;
    return selection.getRangeAt(0).cloneRange();
  };

  const restoreEditorSelection = (editor: HTMLElement, range?: Range) => {
    editor.focus({ preventScroll: true });
    if (!range) return;
    const selection = window.getSelection();
    selection?.removeAllRanges();
    selection?.addRange(range);
  };

  const storyParagraphAtSelection = () => {
    const selection = window.getSelection();
    if (!selection?.rangeCount) return undefined;
    const node = selection.getRangeAt(0).startContainer;
    const element =
      node.nodeType === Node.ELEMENT_NODE
        ? (node as HTMLElement)
        : node.parentElement;
    const paragraph = element?.closest<HTMLParagraphElement>("p");
    return paragraph && storyEditor.contains(paragraph) ? paragraph : undefined;
  };

  const storySelectionHtml = () => {
    const selection = window.getSelection();
    if (!selection?.rangeCount) return "";
    const range = selection.getRangeAt(0);
    if (range.collapsed) return storyParagraphAtSelection()?.innerHTML || "";
    const container = document.createElement("div");
    container.append(range.cloneContents());
    return container.innerHTML;
  };

  const replaceStorySelection = (html: string) => {
    if (!html.trim()) return;
    const selection = window.getSelection();
    if (selection?.rangeCount && selection.getRangeAt(0).collapsed) {
      const paragraph = storyParagraphAtSelection();
      if (paragraph) {
        const range = document.createRange();
        range.selectNodeContents(paragraph);
        selection.removeAllRanges();
        selection.addRange(range);
      }
    }
    executeRichTextCommand("insertHTML", html);
  };

  const insertStoryPause = () => {
    const selection = window.getSelection();
    if (!selection?.rangeCount) return;
    const range = selection.getRangeAt(0);
    range.collapse(true);
    selection.removeAllRanges();
    selection.addRange(range);
    executeRichTextCommand("insertText", "\n###\n");
  };

  const insertStoryHtml = (html: string) => {
    const selection = window.getSelection();
    const range =
      selection?.rangeCount && storyEditor.contains(selection.anchorNode)
        ? selection.getRangeAt(0)
        : null;
    if (!range) {
      storyEditor.insertAdjacentHTML("beforeend", html);
      return;
    }
    const template = document.createElement("template");
    template.innerHTML = html;
    const lastNode = template.content.lastChild;
    range.deleteContents();
    range.insertNode(template.content);
    if (lastNode && selection) {
      range.setStartAfter(lastNode);
      range.collapse(true);
      selection.removeAllRanges();
      selection.addRange(range);
    }
  };

  storyEditor.addEventListener("input", () => syncStoryEditor());
  storyEditor.addEventListener("blur", () => {
    syncStoryEditor();
  });
  storyEditor.addEventListener("paste", (event) => {
    const html = event.clipboardData?.getData("text/html");
    const text = event.clipboardData?.getData("text/plain") || "";
    event.preventDefault();
    insertStoryHtml(
      html && hasStructuredStoryHtml(html)
        ? wordHtmlToStoryHtml(html, document)
        : storyTextToEditorHtml(text || html || "", document),
    );
    syncStoryEditor();
  });

  document
    .querySelectorAll<HTMLButtonElement>("[data-story-command]")
    .forEach((button) => {
      let selection: Range | undefined;
      button.addEventListener("pointerdown", (event) => {
        selection = captureEditorSelection(storyEditor);
        event.preventDefault();
      });
      button.addEventListener("click", () => {
        restoreEditorSelection(storyEditor, selection);
        const command = button.dataset.storyCommand!;
        executeRichTextCommand(command);
        notifyRichTextChange(storyEditor);
      });
    });
  document
    .querySelectorAll<HTMLButtonElement>("[data-story-transform]")
    .forEach((button) => {
      let selection: Range | undefined;
      button.addEventListener("pointerdown", (event) => {
        selection = captureEditorSelection(storyEditor);
        event.preventDefault();
      });
      button.addEventListener("click", () => {
        restoreEditorSelection(storyEditor, selection);
        const tag = button.dataset.storyTransform!;
        replaceStorySelection(`<${tag}>${storySelectionHtml()}</${tag}>`);
        notifyRichTextChange(storyEditor);
      });
    });
  document
    .querySelectorAll<HTMLButtonElement>("[data-story-list]")
    .forEach((button) => {
      let selection: Range | undefined;
      button.addEventListener("pointerdown", (event) => {
        selection = captureEditorSelection(storyEditor);
        event.preventDefault();
      });
      button.addEventListener("click", () => {
        restoreEditorSelection(storyEditor, selection);
        const listTag = button.dataset.storyList!;
        replaceStorySelection(
          `<${listTag}><li>${storySelectionHtml()}</li></${listTag}>`,
        );
        notifyRichTextChange(storyEditor);
      });
    });
  document
    .querySelectorAll<HTMLButtonElement>("[data-story-indent]")
    .forEach((button) => {
      let selection: Range | undefined;
      button.addEventListener("pointerdown", (event) => {
        selection = captureEditorSelection(storyEditor);
        event.preventDefault();
      });
      button.addEventListener("click", () => {
        restoreEditorSelection(storyEditor, selection);
        const paragraph = storyParagraphAtSelection();
        if (!paragraph) return;
        if (button.dataset.storyIndent === "in")
          paragraph.dataset.indent = "true";
        else delete paragraph.dataset.indent;
        notifyRichTextChange(storyEditor);
      });
    });
  document
    .querySelectorAll<HTMLButtonElement>("[data-story-pause]")
    .forEach((button) => {
      let selection: Range | undefined;
      button.addEventListener("pointerdown", (event) => {
        selection = captureEditorSelection(storyEditor);
        event.preventDefault();
      });
      button.addEventListener("click", () => {
        restoreEditorSelection(storyEditor, selection);
        insertStoryPause();
        notifyRichTextChange(storyEditor);
      });
    });
  document
    .querySelectorAll<HTMLButtonElement>("[data-story-drop-cap]")
    .forEach((button) => {
      let selection: Range | undefined;
      button.addEventListener("pointerdown", (event) => {
        selection = captureEditorSelection(storyEditor);
        event.preventDefault();
      });
      button.addEventListener("click", () => {
        restoreEditorSelection(storyEditor, selection);
        const range = captureEditorSelection(storyEditor);
        const selectedParagraph = storyParagraphAtSelection();
        if (!range || !selectedParagraph) return;
        const selectedMarker =
          (range.startContainer.nodeType === Node.ELEMENT_NODE
            ? (range.startContainer as HTMLElement)
            : range.startContainer.parentElement
          )?.closest<HTMLElement>("[data-drop-cap='true']");
        if (selectedMarker && storyEditor.contains(selectedMarker)) {
          selectedMarker.replaceWith(...selectedMarker.childNodes);
        } else if (!range.collapsed) {
          const endElement =
            range.endContainer.nodeType === Node.ELEMENT_NODE
              ? (range.endContainer as HTMLElement)
              : range.endContainer.parentElement;
          if (endElement?.closest("p") !== selectedParagraph) return;
          const marker = document.createElement("span");
          marker.dataset.dropCap = "true";
          marker.append(range.extractContents());
          range.insertNode(marker);
          range.selectNodeContents(marker);
          window.getSelection()?.removeAllRanges();
          window.getSelection()?.addRange(range);
        }
        notifyRichTextChange(storyEditor);
      });
    });

  document
    .querySelector("[data-save-local]")
    ?.addEventListener("click", () => saveLocalDraft(true));

  const updateVisibilityRequirements = () => {
    const visibility = (
      workForm.elements.namedItem("contentVisibility") as RadioNodeList
    ).value;
    const fullStory = workForm.elements.namedItem(
      "storyContent",
    ) as HTMLTextAreaElement;
    const publicationUrl = workForm.elements.namedItem(
      "primaryExternalUrl",
    ) as HTMLInputElement;
    const audioUrl = workForm.elements.namedItem(
      "audioUrl",
    ) as HTMLInputElement;
    const purchaseUrl = workForm.elements.namedItem(
      "purchaseUrl",
    ) as HTMLInputElement;
    fullStory.required = false;
    storyEditor.setAttribute("aria-required", String(visibility === "full"));
    fullStory.closest<HTMLElement>("[data-full-story-field]")!.hidden =
      visibility !== "full";
    const linkOnly = visibility === "external-only";
    publicationUrl.required = linkOnly;
    audioUrl.required = false;
    document.querySelector<HTMLElement>("[data-matching-url-note]")!.hidden =
      !areSameExternalUrls(publicationUrl.value, purchaseUrl.value);
    document.querySelector<HTMLElement>("[data-full-warning]")!.hidden =
      visibility !== "full";
  };

  workForm
    .querySelectorAll<HTMLInputElement>('[name="contentVisibility"]')
    .forEach((radio) =>
      radio.addEventListener("change", updateVisibilityRequirements),
    );

  workForm
    .querySelectorAll<HTMLButtonElement>("[data-editor-action]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        (
          workForm.elements.namedItem("publishedAt") as HTMLInputElement
        ).required = button.dataset.editorAction === "publish";
      });
    });

  const updatePreview = () => {
    const story = storyEditor.innerHTML.trim();
    document.querySelector<HTMLElement>("[data-markdown-preview]")!.innerHTML =
      story || "<p>Your preview will appear here.</p>";
  };

  workForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (workSaveInFlight) return;
    syncStoryEditor(true);
    const visibility = String(
      (workForm.elements.namedItem("contentVisibility") as RadioNodeList).value,
    );
    if (visibility === "full" && !fullStoryField.value.trim()) {
      editorStatus.textContent = "Add the full story before saving this work.";
      storyEditor.focus();
      return;
    }
    const submitter = (event as SubmitEvent).submitter;
    const submitButton =
      submitter instanceof HTMLButtonElement ? submitter : null;
    const action = submitButton?.dataset.editorAction || "save";
    const formData = new FormData(workForm);
    const id = String(formData.get("id") || "");
    const optional = (name: string) =>
      String(formData.get(name) || "").trim() || undefined;
    const date = optional("publishedAt");
    const payload = {
      slug: String(formData.get("slug")),
      title: String(formData.get("title")),
      expectedUpdatedAt: optional("updatedAt"),
      status:
        action === "publish" || originalStatus === "published"
          ? "published"
          : "draft",
      publicationType: String(formData.get("publicationType")),
      publishedAt: date ? `${date}T00:00:00Z` : undefined,
      wordCount: optional("wordCount")
        ? Number(formData.get("wordCount"))
        : undefined,
      blurb: String(formData.get("blurb")),
      storyContent: optional("storyContent"),
      contentVisibility: String(formData.get("contentVisibility")),
      publisherName: optional("publisherName"),
      primaryExternalUrl: optional("primaryExternalUrl"),
      audioUrl: optional("audioUrl"),
      purchaseUrl: optional("purchaseUrl"),
      socialPostUrl: optional("socialPostUrl"),
      socialEmbedEnabled: formData.get("socialEmbedEnabled") === "on",
      workImageUrl: optional("workImageUrl"),
      genres: String(formData.get("genres") || "")
        .split(",")
        .map((value) => value.trim())
        .filter(Boolean),
      featured: formData.get("featured") === "on",
    };
    if (
      action === "publish" &&
      payload.contentVisibility === "full" &&
      !confirm(
        "This will publish the complete story for anyone to read. Confirm that you hold the digital rights.",
      )
    )
      return;
    if (
      action === "publish" &&
      !confirm(
        "Ready to publish? This will make the work public immediately. Static SEO files will refresh in the background.",
      )
    )
      return;
    const wasPublished = originalStatus === "published";
    workSaveInFlight = true;
    editorStatus.textContent = "Saving…";
    const actionButtons = Array.from(
      workForm.querySelectorAll<HTMLButtonElement>("[data-editor-action]"),
    );
    actionButtons.forEach((button) => {
      setButtonBusy(button, button === submitButton);
      button.disabled = true;
    });
    try {
      const savedWork = await request(
        id ? `/api/v1/admin/works/${id}` : "/api/v1/admin/works",
        {
          method: id ? "PUT" : "POST",
          body: JSON.stringify(payload),
        },
      );
      dirty = false;
      window.clearTimeout(localSaveTimer);
      clearLocalDraft();
      originalStatus = savedWork.status;
      await loadDashboard();
      const needsSeoRefresh = savedWork.status === "published" || wasPublished;
      if (needsSeoRefresh) {
        try {
          await triggerDeployment(editorStatus);
          editorStatus.textContent =
            savedWork.status === "published"
              ? "Published and visible now. Static SEO files will refresh in the background."
              : "Draft saved. The public version has been removed; static SEO files will refresh in the background.";
          window.setTimeout(() => dialog.close(), 1800);
        } catch (deploymentError) {
          editorStatus.textContent =
            savedWork.status === "published"
              ? `Published and visible now. ${(deploymentError as Error).message}`
              : `Draft saved and removed from the public site. ${(deploymentError as Error).message}`;
        }
      } else {
        editorStatus.textContent =
          "Saved online. You can continue on another device.";
        window.setTimeout(() => dialog.close(), 1200);
      }
    } catch (error) {
      editorStatus.textContent = (error as Error).message;
    } finally {
      workSaveInFlight = false;
      actionButtons.forEach((button) => {
        setButtonBusy(button, false);
        button.disabled = false;
      });
    }
  });

  archiveButton.addEventListener("click", async () => {
    const id = String(new FormData(workForm).get("id") || "");
    if (
      !id ||
      !confirm(
        "Archive this work? It will disappear from the public site after the next site build.",
      )
    )
      return;
    editorStatus.textContent = "Archiving…";
    setButtonBusy(archiveButton, true);
    archiveButton.disabled = true;
    try {
      const updatedAt = String(new FormData(workForm).get("updatedAt") || "");
      await request(`/api/v1/admin/works/${id}`, {
        method: "DELETE",
        headers: { "If-Unmodified-Since": updatedAt },
      });
      dirty = false;
      window.clearTimeout(localSaveTimer);
      clearLocalDraft();
      await loadDashboard();
      await triggerDeployment(editorStatus);
      editorStatus.textContent =
        "Archived and removed from the public site. Static SEO files will refresh in the background.";
      window.setTimeout(() => dialog.close(), 1800);
    } catch (error) {
      editorStatus.textContent = (error as Error).message;
    } finally {
      setButtonBusy(archiveButton, false);
      archiveButton.disabled = false;
    }
  });

  const settingsForm = document.querySelector<HTMLFormElement>(
    "[data-settings-form]",
  )!;
  const homepageHeadingEditor = document.querySelector<HTMLElement>(
    "[data-homepage-heading-editor]",
  )!;
  const homepageHeadingInput = settingsForm.elements.namedItem(
    "homepageHeadingHtml",
  ) as HTMLTextAreaElement;
  const socialLinksEditor = settingsForm.querySelector<HTMLElement>(
    "[data-social-links]",
  )!;
  const announcementInput = settingsForm.elements.namedItem(
    "announcement",
  ) as HTMLTextAreaElement;
  const announcementCount = settingsForm.querySelector<HTMLElement>(
    "[data-announcement-count]",
  )!;
  const profileImageInput = settingsForm.elements.namedItem(
    "profileImageUrl",
  ) as HTMLInputElement;
  const profilePreview = settingsForm.querySelector<HTMLImageElement>(
    "[data-profile-preview]",
  )!;
  let currentThemeSettings: Record<string, string> = {};

  const updateAnnouncementCount = () => {
    announcementCount.textContent = String(announcementInput.value.length);
  };

  const syncHomepageHeading = () => {
    homepageHeadingInput.value = homepageHeadingEditor.innerHTML.trim();
  };

  const updateProfilePreview = () => {
    const url = profileImageInput.value.trim();
    if (!url) {
      profilePreview.hidden = true;
      profilePreview.removeAttribute("src");
      return;
    }
    profilePreview.src = url;
    profilePreview.hidden = false;
  };

  const addSocialLinkRow = (label = "", url = "") => {
    const row = document.createElement("div");
    row.className = "social-link-row";

    const labelField = document.createElement("label");
    const labelCaption = document.createElement("span");
    labelCaption.textContent = "Label";
    const labelInput = document.createElement("input");
    labelInput.type = "text";
    labelInput.maxLength = 80;
    labelInput.required = true;
    labelInput.value = label;
    labelInput.dataset.socialLabel = "";
    labelField.append(labelCaption, labelInput);

    const urlField = document.createElement("label");
    const urlCaption = document.createElement("span");
    urlCaption.textContent = "Link";
    const urlInput = document.createElement("input");
    urlInput.type = "url";
    urlInput.required = true;
    urlInput.placeholder = "https://…";
    urlInput.value = url;
    urlInput.dataset.socialUrl = "";
    urlField.append(urlCaption, urlInput);

    const removeButton = document.createElement("button");
    removeButton.className = "text-button";
    removeButton.type = "button";
    removeButton.textContent = "Remove";
    removeButton.setAttribute("aria-label", `Remove ${label || "social"} link`);
    removeButton.addEventListener("click", () => row.remove());

    row.append(labelField, urlField, removeButton);
    socialLinksEditor.append(row);
  };

  const renderSocialLinks = (socialLinks: Record<string, string>) => {
    socialLinksEditor.replaceChildren();
    Object.entries(socialLinks).forEach(([label, url]) =>
      addSocialLinkRow(label, url),
    );
  };

  const collectSocialLinks = () => {
    const socialLinks: Record<string, string> = {};
    socialLinksEditor
      .querySelectorAll<HTMLElement>(".social-link-row")
      .forEach((row) => {
        const label = row
          .querySelector<HTMLInputElement>("[data-social-label]")!
          .value.trim();
        const url = row
          .querySelector<HTMLInputElement>("[data-social-url]")!
          .value.trim();
        if (label && url) socialLinks[label] = url;
      });
    return socialLinks;
  };

  const loadSettings = async () => {
    const settings = await request("/api/v1/admin/settings");
    currentThemeSettings = settings.themeSettings || {};
    [
      "authorName",
      "homepageEyebrow",
      "introduction",
      "biography",
      "profileImageUrl",
      "announcement",
      "contactLink",
    ].forEach((key) => {
      const input = settingsForm.elements.namedItem(key) as
        HTMLInputElement | HTMLTextAreaElement | null;
      if (input) input.value = String(settings[key] ?? "");
    });
    homepageHeadingEditor.innerHTML = String(settings.homepageHeadingHtml);
    syncHomepageHeading();
    renderSocialLinks(settings.socialLinks || {});
    updateAnnouncementCount();
    updateProfilePreview();
  };

  announcementInput.addEventListener("input", updateAnnouncementCount);
  homepageHeadingEditor.addEventListener("input", syncHomepageHeading);
  homepageHeadingEditor.addEventListener("paste", (event) => {
    event.preventDefault();
    const text = event.clipboardData?.getData("text/plain") || "";
    executeRichTextCommand("insertText", text);
    syncHomepageHeading();
  });
  settingsForm
    .querySelectorAll<HTMLButtonElement>("[data-homepage-heading-command]")
    .forEach((button) => {
      let selection: Range | undefined;
      button.addEventListener("pointerdown", (event) => {
        selection = captureEditorSelection(homepageHeadingEditor);
        event.preventDefault();
      });
      button.addEventListener("click", () => {
        restoreEditorSelection(homepageHeadingEditor, selection);
        executeRichTextCommand(button.dataset.homepageHeadingCommand!);
        notifyRichTextChange(homepageHeadingEditor);
      });
    });
  profileImageInput.addEventListener("input", updateProfilePreview);
  profilePreview.addEventListener("error", () => {
    profilePreview.hidden = true;
  });
  settingsForm
    .querySelector("[data-add-social]")
    ?.addEventListener("click", () => addSocialLinkRow());

  settingsForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submitter = (event as SubmitEvent).submitter;
    const submitButton =
      submitter instanceof HTMLButtonElement ? submitter : null;
    const form = new FormData(event.currentTarget as HTMLFormElement);
    const payload = {
      authorName: form.get("authorName"),
      homepageEyebrow: form.get("homepageEyebrow"),
      homepageHeadingHtml: form.get("homepageHeadingHtml"),
      introduction: form.get("introduction"),
      biography: form.get("biography"),
      profileImageUrl: form.get("profileImageUrl") || undefined,
      announcement: form.get("announcement") || undefined,
      contactLink: form.get("contactLink") || undefined,
      socialLinks: collectSocialLinks(),
      themeSettings: currentThemeSettings,
    };
    const status = document.querySelector<HTMLElement>(
      "[data-settings-status]",
    )!;
    status.textContent = "Saving…";
    if (submitButton) {
      setButtonBusy(submitButton, true);
      submitButton.disabled = true;
    }
    try {
      await request("/api/v1/admin/settings", {
        method: "PUT",
        body: JSON.stringify(payload),
      });
      await triggerDeployment(status);
      status.textContent =
        "Settings saved. Static SEO files will refresh in the background.";
    } catch (error) {
      status.textContent = (error as Error).message;
    } finally {
      if (submitButton) {
        setButtonBusy(submitButton, false);
        submitButton.disabled = false;
      }
    }
  });

  document
    .querySelector("[data-rebuild]")
    ?.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      setButtonBusy(button, true);
      button.disabled = true;
      try {
        await triggerDeployment();
      } catch (error) {
        deploymentStatus.textContent = (error as Error).message;
      } finally {
        setButtonBusy(button, false);
        button.disabled = false;
      }
    });

  document
    .querySelector("[data-export]")
    ?.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      setButtonBusy(button, true);
      button.disabled = true;
      try {
        const data = await request("/api/v1/admin/export");
        const link = document.createElement("a");
        link.href = URL.createObjectURL(
          new Blob([JSON.stringify(data, null, 2)], {
            type: "application/json",
          }),
        );
        link.download = `author-library-${new Date().toISOString().slice(0, 10)}.json`;
        link.click();
        URL.revokeObjectURL(link.href);
      } finally {
        setButtonBusy(button, false);
        button.disabled = false;
      }
    });

  window.addEventListener("beforeunload", (event) => {
    if (dirty) {
      saveLocalDraft();
      event.preventDefault();
    }
  });
  refreshSession();
</script>
