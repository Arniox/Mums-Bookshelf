---
import BookShelf from "../components/BookShelf.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublicSettings, getPublicWorks } from "../lib/contentSource";

const [settings, works] = await Promise.all([
  getPublicSettings(),
  getPublicWorks(),
]);
const recent = [...works]
  .sort(
    (left, right) =>
      Date.parse(right.publishedAt || "") - Date.parse(left.publishedAt || ""),
  )
  .slice(0, 3);
const base = import.meta.env.BASE_URL;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: settings.authorName,
  url: new URL(base, Astro.site),
  jobTitle: "Author",
};
---

<BaseLayout siteSettings={settings}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />
  <div class="library-room">
    <section class="library-intro" aria-labelledby="welcome-title">
      <div class="library-sign">
        <p class="eyebrow" data-homepage-eyebrow>{settings.homepageEyebrow}</p>
        <h1
          id="welcome-title"
          data-homepage-heading
          set:html={settings.homepageHeadingHtml}
        />
        <p class="hero-intro" data-author-introduction>
          {settings.introduction}
        </p>
        <a class="text-link" href={`${base}about/`} data-homepage-author-link
          >Meet <span data-author-first-name
            >{settings.authorName.split(/\s+/)[0]}</span
          >
          <span aria-hidden="true">→</span></a
        >
      </div>
      <aside
        class="room-announcement"
        aria-label="Author announcement"
        data-homepage-announcement
        hidden={!settings.announcement}
      >
        <span class="announcement-mark" aria-hidden="true"> ✦ </span>
        <span>
          <strong
            >From <span data-author-first-name
              >{settings.authorName.split(/\s+/)[0]}</span
            >'s writing desk</strong
          >
          <span data-homepage-announcement-text>{settings.announcement}</span>
        </span>
      </aside>
    </section>

    {
      recent.length > 0 && (
        <aside class="recent-slip" aria-labelledby="recent-title" data-recent>
          <div class="recent-slip-heading">
            <span class="recent-slip-mark" aria-hidden="true">
              ◈
            </span>
            <div>
              <p class="eyebrow">Fresh from the desk</p>
              <h2 id="recent-title">Recently published</h2>
            </div>
          </div>
          <ol data-recent-list>
            {recent.map((work) => (
              <li>
                <a href={`${base}works/${work.slug}/`}>{work.title}</a>
                {work.publishedAt && (
                  <time datetime={work.publishedAt}>
                    {new Intl.DateTimeFormat("en", {
                      month: "short",
                      year: "numeric",
                    }).format(new Date(work.publishedAt))}
                  </time>
                )}
              </li>
            ))}
          </ol>
          <a class="text-link" href={`${base}works/`}>
            Browse the whole shelf <span aria-hidden="true">→</span>
          </a>
        </aside>
      )
    }

    <BookShelf
      works={works}
      recentWorkSlugs={recent.slice(0, 1).map((work) => work.slug)}
    />
  </div>

  <section class="closing-note">
    <span aria-hidden="true">“</span>
    <blockquote data-author-introduction>{settings.introduction}</blockquote>
    <p>— <span data-author-name>{settings.authorName}</span></p>
  </section>
</BaseLayout>

<script>
  import {
    getRuntimePublicSettings,
    getRuntimePublicWorks,
  } from "../lib/runtimeContent";

  const recentList =
    document.querySelector<HTMLOListElement>("[data-recent-list]");
  const base = import.meta.env.BASE_URL;
  const formatDate = (publishedAt: string) =>
    new Intl.DateTimeFormat("en", {
      month: "short",
      year: "numeric",
    }).format(new Date(publishedAt));

  const renderRecent = (
    works: Awaited<ReturnType<typeof getRuntimePublicWorks>>,
  ) => {
    if (!recentList) return;
    const recent = [...works]
      .sort(
        (left, right) =>
          Date.parse(right.publishedAt || "") -
          Date.parse(left.publishedAt || ""),
      )
      .slice(0, 3);
    recentList.replaceChildren(
      ...recent.map((work) => {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = `${base}works/${work.slug}/`;
        link.textContent = work.title;
        item.append(link);
        if (work.publishedAt) {
          const date = document.createElement("time");
          date.dateTime = work.publishedAt;
          date.textContent = formatDate(work.publishedAt);
          item.append(date);
        }
        return item;
      }),
    );
  };

  void getRuntimePublicWorks()
    .then(renderRecent)
    .catch(() => undefined);

  void getRuntimePublicSettings()
    .then((settings) => {
      const eyebrow = document.querySelector<HTMLElement>(
        "[data-homepage-eyebrow]",
      );
      if (eyebrow) eyebrow.textContent = settings.homepageEyebrow;
      const heading = document.querySelector<HTMLElement>(
        "[data-homepage-heading]",
      );
      if (heading) heading.innerHTML = settings.homepageHeadingHtml;
      document
        .querySelectorAll<HTMLElement>("[data-author-first-name]")
        .forEach((element) => {
          element.textContent = settings.authorName.split(/\s+/)[0] || "";
        });
      document
        .querySelectorAll<HTMLElement>("[data-author-name]")
        .forEach((element) => {
          element.textContent = settings.authorName;
        });
      const announcement = document.querySelector<HTMLElement>(
        "[data-homepage-announcement]",
      );
      const announcementText = document.querySelector<HTMLElement>(
        "[data-homepage-announcement-text]",
      );
      if (announcement && announcementText) {
        announcement.hidden = !settings.announcement;
        announcementText.textContent = settings.announcement || "";
      }
    })
    .catch(() => undefined);
</script>
