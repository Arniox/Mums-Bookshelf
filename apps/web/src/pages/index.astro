---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookShelf from "../components/BookShelf.astro";
import WorkCard from "../components/WorkCard.astro";
import { getPublicSettings, getPublicWorks } from "../lib/contentSource";

const [settings, works] = await Promise.all([
  getPublicSettings(),
  getPublicWorks(),
]);
const recent = [...works]
  .sort(
    (left, right) =>
      Date.parse(right.publishedAt || "") - Date.parse(left.publishedAt || ""),
  )
  .slice(0, 3);
const base = import.meta.env.BASE_URL;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: settings.authorName,
  url: new URL(base, Astro.site),
  jobTitle: "Author",
};
---

<BaseLayout siteSettings={settings}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />
  <div class="library-room">
    <section class="library-intro" aria-labelledby="welcome-title">
      <div class="library-sign">
        <p class="eyebrow">Fiction · Essays · Small observations</p>
        <h1 id="welcome-title">Stories for the <em>quietly curious.</em></h1>
        <p class="hero-intro">{settings.introduction}</p>
        <a class="text-link" href={`${base}about/`}
          >Meet {settings.authorName.split(/\s+/)[0]}
          <span aria-hidden="true">→</span></a
        >
      </div>
      <p class="room-whisper" aria-hidden="true">
        Take a book down.<br />Stay awhile.
      </p>
    </section>

    <BookShelf works={works} />

    <section class="writing-desk" aria-label="The writing desk">
      <div class="desk-surface">
        {
          settings.announcement ? (
            <aside
              class="announcement desk-plaque"
              aria-label="Author announcement"
            >
              <span class="announcement-mark" aria-hidden="true">
                ✦
              </span>
              <span>
                <strong>From Denise's writing desk</strong>
                <span>{settings.announcement}</span>
              </span>
            </aside>
          ) : (
            <aside class="announcement desk-plaque">
              <span class="announcement-mark" aria-hidden="true">
                ✦
              </span>
              <span>
                <strong>From the writing desk</strong>
                <span>New stories are always taking shape.</span>
              </span>
            </aside>
          )
        }
        <div class="desk-card">
          <p class="eyebrow">The complete collection</p>
          <p>Browse every published story, essay and book in the library.</p>
          <a class="button primary" href={`${base}works/`}>View all works →</a>
        </div>
      </div>
    </section>
  </div>

  <section class="recent-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Fresh from the desk</p>
        <h2>Recently published</h2>
      </div>
      <a class="text-link" href={`${base}works/`}
        >View all works <span aria-hidden="true">→</span></a
      >
    </div>
    <div class="recent-grid">
      {
        recent.map((work) => (
          <WorkCard work={work} authorName={settings.authorName} />
        ))
      }
    </div>
  </section>

  <section class="closing-note">
    <span aria-hidden="true">“</span>
    <blockquote>{settings.introduction}</blockquote>
    <p>— {settings.authorName}</p>
  </section>
</BaseLayout>
