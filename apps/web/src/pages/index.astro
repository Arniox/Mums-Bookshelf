---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookShelf from "../components/BookShelf.astro";
import WorkCard from "../components/WorkCard.astro";
import { getPublicSettings, getPublicWorks } from "../lib/contentSource";

const [settings, works] = await Promise.all([getPublicSettings(), getPublicWorks()]);
const featured = works.filter((work) => work.featured);
const recent = [...works]
  .sort((left, right) => Date.parse(right.publishedAt || "") - Date.parse(left.publishedAt || ""))
  .slice(0, 3);
const base = import.meta.env.BASE_URL;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: settings.authorName,
  url: new URL(base, Astro.site),
  jobTitle: "Author"
};
---

<BaseLayout siteSettings={settings}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <section class="hero">
    <div class="hero-copy">
      {
        settings.announcement && (
          <aside class="announcement" aria-label="Author announcement">
            <span class="announcement-mark" aria-hidden="true">✦</span>
            <span>
              <strong>From the writing desk</strong>
              <span>{settings.announcement}</span>
            </span>
          </aside>
        )
      }
      <p class="eyebrow">Fiction · Essays · Small observations</p>
      <h1>Stories for the<br /><em>quietly curious.</em></h1>
      <p class="hero-intro">{settings.introduction}</p>
      <div class="button-row">
        <a class="button primary" href={`${base}works/`}>Explore the works <span aria-hidden="true">→</span></a>
        <a class="button secondary" href={`${base}about/`}>About {settings.authorName.split(/\s+/)[0]}</a>
      </div>
    </div>
    {featured.length > 0 ? (
      <div class="hero-feature" aria-label="Featured work">
        <div class="paper-stack">
          <article>
            <p class="eyebrow">Featured reading</p>
            <span class="ornament">✦</span>
            <h2>{featured[1]?.title || featured[0]?.title}</h2>
            <p>{featured[1]?.blurb || featured[0]?.blurb}</p>
            <a href={`${base}works/${featured[1]?.slug || featured[0]?.slug}/`}>
              Read the story <span aria-hidden="true">→</span>
            </a>
          </article>
        </div>
        <p class="hand-note" aria-hidden="true">a good place to begin ↗</p>
      </div>
    ) : (
      <div class="hero-feature" aria-label="Bookshelf coming soon">
        <div class="paper-stack">
          <article>
            <p class="eyebrow">From the writing desk</p>
            <span class="ornament">✦</span>
            <h2>The shelf is being prepared</h2>
            <p>Books and stories will appear here as they are published.</p>
            <a href={`${base}about/`}>Meet the author <span aria-hidden="true">→</span></a>
          </article>
        </div>
      </div>
    )}
  </section>

  <BookShelf works={works} />

  <section class="recent-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Fresh from the desk</p>
        <h2>Recently published</h2>
      </div>
      <a class="text-link" href={`${base}works/`}>View all works <span aria-hidden="true">→</span></a>
    </div>
    <div class="recent-grid">
      {recent.map((work) => <WorkCard work={work} authorName={settings.authorName} />)}
    </div>
  </section>

  <section class="closing-note">
    <span aria-hidden="true">“</span>
    <blockquote>{settings.introduction}</blockquote>
    <p>— {settings.authorName}</p>
  </section>
</BaseLayout>
