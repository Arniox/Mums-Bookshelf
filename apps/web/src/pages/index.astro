---
import BookShelf from "../components/BookShelf.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublicSettings, getPublicWorks } from "../lib/contentSource";

const [settings, works] = await Promise.all([
  getPublicSettings(),
  getPublicWorks(),
]);
const recent = [...works]
  .sort(
    (left, right) =>
      Date.parse(right.publishedAt || "") - Date.parse(left.publishedAt || ""),
  )
  .slice(0, 3);
const base = import.meta.env.BASE_URL;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: settings.authorName,
  url: new URL(base, Astro.site),
  jobTitle: "Author",
};
---

<BaseLayout siteSettings={settings}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />
  <div class="library-room">
    <section class="library-intro" aria-labelledby="welcome-title">
      <div class="library-sign">
        <p class="eyebrow">Fiction · Essays · Small observations</p>
        <h1 id="welcome-title">Stories for the <em>quietly curious.</em></h1>
        <p class="hero-intro">{settings.introduction}</p>
        <a class="text-link" href={`${base}about/`}
          >Meet {settings.authorName.split(/\s+/)[0]}
          <span aria-hidden="true">→</span></a
        >
      </div>
      {
        settings.announcement && (
          <aside class="room-announcement" aria-label="Author announcement">
            <span class="announcement-mark" aria-hidden="true">
              ✦
            </span>
            <span>
              <strong>From Denise's writing desk</strong>
              <span>{settings.announcement}</span>
            </span>
          </aside>
        )
      }
    </section>

    {
      recent.length > 0 && (
        <aside class="recent-slip" aria-labelledby="recent-title" data-recent>
          <div class="recent-slip-heading">
            <span class="recent-slip-mark" aria-hidden="true">◈</span>
            <div>
              <p class="eyebrow">Fresh from the desk</p>
              <h2 id="recent-title">Recently published</h2>
            </div>
          </div>
          <ol data-recent-list>
            {recent.map((work) => (
              <li>
                <a href={`${base}works/${work.slug}/`}>{work.title}</a>
                {work.publishedAt && (
                  <time datetime={work.publishedAt}>
                    {new Intl.DateTimeFormat("en", {
                      month: "short",
                      year: "numeric",
                    }).format(new Date(work.publishedAt))}
                  </time>
                )}
              </li>
            ))}
          </ol>
          <a class="text-link" href={`${base}works/`}>
            Browse the whole shelf <span aria-hidden="true">→</span>
          </a>
        </aside>
      )
    }

    <BookShelf works={works} recentWorkSlugs={recent.map((work) => work.slug)} />
  </div>

  <section class="closing-note">
    <span aria-hidden="true">“</span>
    <blockquote>{settings.introduction}</blockquote>
    <p>— {settings.authorName}</p>
  </section>
</BaseLayout>

<script>
  import { getRuntimePublicWorks } from "../lib/runtimeContent";

  const recentList = document.querySelector<HTMLOListElement>(
    "[data-recent-list]",
  );
  const base = import.meta.env.BASE_URL;
  const formatDate = (publishedAt: string) =>
    new Intl.DateTimeFormat("en", {
      month: "short",
      year: "numeric",
    }).format(new Date(publishedAt));

  const renderRecent = (works: Awaited<ReturnType<typeof getRuntimePublicWorks>>) => {
    if (!recentList) return;
    const recent = [...works]
      .sort(
        (left, right) =>
          Date.parse(right.publishedAt || "") -
          Date.parse(left.publishedAt || ""),
      )
      .slice(0, 3);
    recentList.replaceChildren(
      ...recent.map((work) => {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = `${base}works/${work.slug}/`;
        link.textContent = work.title;
        item.append(link);
        if (work.publishedAt) {
          const date = document.createElement("time");
          date.dateTime = work.publishedAt;
          date.textContent = formatDate(work.publishedAt);
          item.append(date);
        }
        return item;
      }),
    );
  };

  void getRuntimePublicWorks().then(renderRecent).catch(() => undefined);
</script>
