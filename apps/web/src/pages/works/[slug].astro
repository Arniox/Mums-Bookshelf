---
import { areSameExternalUrls, sanitiseMarkdown } from "@mums-bookshelf/shared";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Comments from "../../components/Comments.astro";
import FallbackCover from "../../components/FallbackCover.astro";
import SocialPost from "../../components/SocialPost.astro";
import WorkCard from "../../components/WorkCard.astro";
import { getPublicSettings, getPublicWorks } from "../../lib/contentSource";

export async function getStaticPaths() {
  const publicWorks = await getPublicWorks();
  return publicWorks
    .filter((work) => work.status === "published")
    .map((work) => ({
      params: { slug: work.slug },
      props: { work, works: publicWorks },
    }));
}

const { work, works } = Astro.props;
const settings = await getPublicSettings();
const date = work.publishedAt
  ? new Intl.DateTimeFormat("en-NZ", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(new Date(work.publishedAt))
  : "";
const related = works
  .filter(
    (candidate) =>
      candidate.id !== work.id &&
      candidate.genres.some((genre) => work.genres.includes(genre)),
  )
  .slice(0, 2);
const storyHtml = work.storyContent ? sanitiseMarkdown(work.storyContent) : "";
const publicationIsPurchase = areSameExternalUrls(
  work.primaryExternalUrl,
  work.purchaseUrl,
);
const base = import.meta.env.BASE_URL;
const schemaType =
  work.publicationType === "book"
    ? "Book"
    : work.publicationType === "short-story"
      ? "ShortStory"
      : "CreativeWork";
const structuredData = {
  "@context": "https://schema.org",
  "@type": schemaType,
  name: work.title,
  description: work.blurb,
  author: { "@type": "Person", name: settings.authorName },
  datePublished: work.publishedAt,
  genre: work.genres,
};
---

<BaseLayout title={work.title} description={work.blurb} siteSettings={settings}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
  <article class="work-detail">
    <a class="back-link" href={`${base}works/`}>← All works</a>
    <header class="work-detail-header">
      <div class="work-detail-cover">
        {
          work.workImageUrl ? (
            <img src={work.workImageUrl} alt={`Image for ${work.title}`} />
          ) : (
            <FallbackCover
              title={work.title}
              seed={work.id}
              authorName={settings.authorName}
              label={work.publicationType.replace("-", " ")}
            />
          )
        }
      </div>
      <div class="work-detail-copy">
        <p class="eyebrow">
          {work.publicationType.replace("-", " ")}
          {date && `· ${date}`}
        </p>
        <h1 data-work-title>{work.title}</h1>
        <p class="work-blurb" data-work-blurb>{work.blurb}</p>
        <dl class="work-facts">
          <div data-publisher-fact hidden={!work.publisherName}>
            <dt>Publisher</dt>
            <dd data-work-publisher>{work.publisherName}</dd>
          </div>
          {
            work.wordCount && (
              <>
                <>
                  <dt>Length</dt>
                  <dd>{work.wordCount.toLocaleString()} words</dd>
                </>
              </>
            )
          }
          {
            work.readingTimeMinutes && work.contentVisibility === "full" && (
              <>
                <>
                  <dt>Reading time</dt>
                  <dd>{work.readingTimeMinutes} minutes</dd>
                </>
              </>
            )
          }
        </dl>
        <div class="button-row" data-work-actions>
          {
            work.contentVisibility === "full" && (
              <a class="button primary" href="#story">
                Begin reading ↓
              </a>
            )
          }
          {
            work.primaryExternalUrl && (
              <a
                class="button primary"
                href={work.primaryExternalUrl}
                rel="noopener noreferrer"
              >
                {publicationIsPurchase ? "View this work" : "View publication"}{" "}
                ↗
              </a>
            )
          }
          {
            work.purchaseUrl && !publicationIsPurchase && (
              <a
                class="button secondary"
                href={work.purchaseUrl}
                rel="noopener noreferrer"
              >
                Purchase ↗
              </a>
            )
          }
          {
            work.audioUrl && (
              <a
                class="button secondary audio-button"
                href={work.audioUrl}
                rel="noopener noreferrer"
              >
                <span aria-hidden="true">♪</span> Listen to the audio ↗
              </a>
            )
          }
        </div>
      </div>
    </header>

    {
      work.contentVisibility === "full" && storyHtml && (
        <section
          class="story-content"
          id="story"
          aria-label={`${work.title}, full story`}
        >
          <p class="eyebrow">Read online</p>
          <div set:html={storyHtml} />
        </section>
      )
    }

    {
      work.socialPostUrl && (
        <SocialPost
          url={work.socialPostUrl}
          authorName={settings.authorName}
          embedEnabled={work.socialEmbedEnabled}
        />
      )
    }

    <footer class="work-actions">
      <div>
        <p class="eyebrow">Filed under</p>
        <div class="tag-row">
          {work.genres.map((genre) => <span>{genre}</span>)}
        </div>
      </div>
      <button
        class="text-button"
        type="button"
        data-share
        data-title={work.title}>Share this work</button
      >
      <p data-share-status aria-live="polite"></p>
    </footer>
    <Comments workId={work.id} />
  </article>

  {
    related.length > 0 && (
      <section class="related-section">
        <div class="section-heading">
          <div>
            <>
              <p class="eyebrow">Continue reading</p>
              <h2>Related works</h2>
            </>
          </div>
        </div>
        <div class="recent-grid">
          {related.map((item) => (
            <WorkCard work={item} authorName={settings.authorName} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  import {
areSameExternalUrls,
type Work,
} from "@mums-bookshelf/shared";
import { getRuntimePublicWork } from "../../lib/runtimeContent";

  const share = document.querySelector<HTMLButtonElement>("[data-share]");
  const status = document.querySelector<HTMLElement>("[data-share-status]");
  const title = document.querySelector<HTMLElement>("[data-work-title]");
  const blurb = document.querySelector<HTMLElement>("[data-work-blurb]");
  const publisher = document.querySelector<HTMLElement>("[data-work-publisher]");
  const publisherFact = document.querySelector<HTMLElement>(
    "[data-publisher-fact]",
  );
  const actions = document.querySelector<HTMLElement>("[data-work-actions]");

  const actionLink = (label: string, href: string, className: string) => {
    const link = document.createElement("a");
    link.className = `button ${className}`;
    link.href = href;
    link.rel = "noopener noreferrer";
    link.textContent = label;
    return link;
  };

  const renderActions = (work: Work) => {
    if (!actions) return;
    const links: HTMLAnchorElement[] = [];
    const publicationIsPurchase = areSameExternalUrls(
      work.primaryExternalUrl,
      work.purchaseUrl,
    );
    if (work.contentVisibility === "full")
      links.push(actionLink("Begin reading", "#story", "primary"));
    if (work.primaryExternalUrl)
      links.push(
        actionLink(
          publicationIsPurchase ? "View this work" : "View publication",
          work.primaryExternalUrl,
          "primary",
        ),
      );
    if (work.purchaseUrl && !publicationIsPurchase)
      links.push(actionLink("Purchase", work.purchaseUrl, "secondary"));
    if (work.audioUrl)
      links.push(actionLink("Listen to the audio", work.audioUrl, "secondary"));
    actions.replaceChildren(...links);
  };

  const refreshWork = (work: Work) => {
    document.title = work.title;
    if (title) title.textContent = work.title;
    if (blurb) blurb.textContent = work.blurb;
    if (publisher) publisher.textContent = work.publisherName || "";
    if (publisherFact) publisherFact.hidden = !work.publisherName;
    renderActions(work);
  };

  const slug = window.location.pathname.split("/").filter(Boolean).at(-1);
  if (slug)
    void getRuntimePublicWork(slug)
      .then(refreshWork)
      .catch(() => undefined);

  share?.addEventListener("click", async () => {
    share.classList.add("is-loading");
    share.setAttribute("aria-busy", "true");
    share.disabled = true;
    const data = {
      title: share.dataset.title || "Shared work",
      url: window.location.href,
    };
    try {
      if (navigator.share) await navigator.share(data);
      else {
        await navigator.clipboard.writeText(window.location.href);
        if (status) status.textContent = "Link copied.";
      }
    } catch (error) {
      if ((error as Error).name !== "AbortError" && status)
        status.textContent = "Unable to share this link.";
    } finally {
      share.classList.remove("is-loading");
      share.setAttribute("aria-busy", "false");
      share.disabled = false;
    }
  });
</script>
