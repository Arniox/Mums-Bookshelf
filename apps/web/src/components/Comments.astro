---
interface Props {
  workId?: string;
}
const { workId } = Astro.props;
---

{
  __COMMENTS_ENABLED__ && (
    <section
      class="comments-section"
      data-comments
      data-work-id={workId}
      data-api={__API_BASE_URL__}
      data-turnstile-key={__TURNSTILE_SITE_KEY__}
      aria-labelledby="comments-title"
      hidden={!workId}
    >
      <div class="comment-stage">
        <div class="comment-stage-heading">
          <p class="eyebrow">Reader responses</p>
          <h2 id="comments-title">A few words from the reading chair</h2>
        </div>
        <div data-comment-list aria-live="polite">
          <p class="comment-empty">Gathering reader notes…</p>
        </div>
        <p class="comment-overflow" data-comment-overflow hidden />
        <button class="button secondary" type="button" data-open-comment-dialog>
          Add a comment
        </button>
      </div>
      <dialog
        class="comment-dialog"
        data-comment-dialog
        aria-labelledby="comment-dialog-title"
      >
        <form method="dialog" class="dialog-close-row">
          <button
            class="icon-button"
            value="cancel"
            aria-label="Close comment form"
          >
            ×
          </button>
        </form>
        <form data-comment-form>
          <h3>Leave a little note</h3>
          <p>No email needed. Your note will appear after approval.</p>
          <label>
            <span>
              Name <small>Optional</small>
            </span>
            <input name="displayName" maxlength="80" autocomplete="name" />
          </label>
          <label>
            <span>Comment</span>
            <textarea
              name="body"
              required
              maxlength="250"
              rows="4"
              aria-describedby="comment-character-limit"
            />
            <small id="comment-character-limit" class="character-count">
              <span data-comment-count>0</span>/250 characters
            </small>
          </label>
          <label class="honeypot" aria-hidden="true">
            Website
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>
          <div data-turnstile />
          <button class="button primary" type="submit">
            Add comment
          </button>
          <p class="form-status" data-comment-status aria-live="polite" />
        </form>
      </dialog>
    </section>
  )
}

<script>
  const section = document.querySelector<HTMLElement>("[data-comments]");
  if (section) {
    const api = section.dataset.api!;
    const list = section.querySelector<HTMLElement>("[data-comment-list]")!;
    const overflow = section.querySelector<HTMLElement>(
      "[data-comment-overflow]",
    )!;
    const dialog = section.querySelector<HTMLDialogElement>(
      "[data-comment-dialog]",
    )!;
    const openDialogButton = section.querySelector<HTMLButtonElement>(
      "[data-open-comment-dialog]",
    )!;
    const status = section.querySelector<HTMLElement>("[data-comment-status]")!;
    const commentBody =
      section.querySelector<HTMLTextAreaElement>('[name="body"]')!;
    const commentCount = section.querySelector<HTMLElement>(
      "[data-comment-count]",
    )!;
    let turnstileToken = "";
    let activeWorkId =
      section.dataset.workId ||
      document.documentElement.dataset.activeWorkId ||
      "";
    let initialised = false;
    let comments: PublicComment[] = [];

    interface PublicComment {
      id: string;
      displayName?: string;
      body: string;
    }

    const updateCommentCount = () => {
      commentCount.textContent = String(commentBody.value.length);
    };
    commentBody.addEventListener("input", updateCommentCount);
    openDialogButton.addEventListener("click", () => {
      status.textContent = "";
      dialog.showModal();
      commentBody.focus();
    });

    const commentBubble = (comment: PublicComment) => {
      const bubble = document.createElement("article");
      bubble.className = "comment-bubble";
      const name = document.createElement("strong");
      name.textContent = comment.displayName || "Anonymous";
      const body = document.createElement("p");
      body.textContent = comment.body;
      bubble.append(name, body);
      return bubble;
    };

    const renderComments = (comments: PublicComment[]) => {
      const visible = comments.slice(-6);
      list.replaceChildren(
        ...(visible.length
          ? visible.map(commentBubble)
          : [
              Object.assign(document.createElement("p"), {
                className: "comment-empty",
                textContent: "No notes yet. You could leave the first one.",
              }),
            ]),
      );
      const hiddenCount = comments.length - visible.length;
      overflow.hidden = hiddenCount === 0;
      overflow.textContent = hiddenCount
        ? `${hiddenCount} earlier ${hiddenCount === 1 ? "note" : "notes"} tucked safely away.`
        : "";
    };

    const loadComments = async () => {
      const response = await fetch(
        `${api}/api/v1/works/${encodeURIComponent(activeWorkId)}/comments`,
      );
      const payload = (await response.json()) as {
        data?: { items?: PublicComment[] };
      };
      if (!response.ok)
        throw new Error("Comments are temporarily unavailable.");
      comments = payload.data?.items || [];
      renderComments(comments);
    };

    const initialise = () => {
      if (initialised || !activeWorkId) return;
      initialised = true;
      section.hidden = false;
      void loadComments().catch(() => {
        list.replaceChildren(
          Object.assign(document.createElement("p"), {
            className: "comment-empty",
            textContent: "Comments are temporarily unavailable.",
          }),
        );
      });
      const siteKey = section.dataset.turnstileKey;
      if (!siteKey) return;
      const script = document.createElement("script");
      script.src =
        "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
      script.async = true;
      script.defer = true;
      script.onload = () => {
        const turnstile = (window as any).turnstile;
        turnstile?.render(section.querySelector("[data-turnstile]"), {
          sitekey: siteKey,
          callback: (token: string) => {
            turnstileToken = token;
          },
        });
      };
      document.body.append(script);
    };

    initialise();
    document.addEventListener("mums-bookshelf:work-ready", (event) => {
      const detail = (event as CustomEvent<{ workId: string }>).detail;
      activeWorkId = detail.workId;
      section.dataset.workId = activeWorkId;
      initialise();
    });

    section
      .querySelector<HTMLFormElement>("[data-comment-form]")
      ?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const submitter = (event as SubmitEvent).submitter;
        const submitButton =
          submitter instanceof HTMLButtonElement ? submitter : null;
        const data = Object.fromEntries(new FormData(form));
        status.textContent = "Sending…";
        if (submitButton) {
          submitButton.classList.add("is-loading");
          submitButton.setAttribute("aria-busy", "true");
          submitButton.disabled = true;
        }
        try {
          const response = await fetch(
            `${api}/api/v1/works/${encodeURIComponent(activeWorkId)}/comments`,
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ ...data, turnstileToken }),
            },
          );
          const payload = await response.json();
          if (!response.ok)
            throw new Error(
              payload.error?.message || "Comment could not be submitted.",
            );
          form.reset();
          updateCommentCount();
          status.textContent = "Your note is waiting for approval.";
          dialog.close();
        } catch (error) {
          status.textContent = (error as Error).message;
        } finally {
          if (submitButton) {
            submitButton.classList.remove("is-loading");
            submitButton.setAttribute("aria-busy", "false");
            submitButton.disabled = false;
          }
        }
      });
  }
</script>

<style is:global>
  .comments-section {
    margin: 5rem 0 0;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }
  .comment-stage {
    padding: 1.5rem;
    border: 1px solid var(--line);
    background:
      linear-gradient(rgba(91, 48, 67, 0.045) 1px, transparent 1px) 0 0 / 100%
        2rem,
      #f8f0e4;
    box-shadow: inset 0 0 0 8px rgba(255, 255, 255, 0.25);
  }
  .comment-stage-heading {
    max-width: 38rem;
    margin: 0 auto 1.2rem;
    text-align: left;
  }
  .comment-stage-heading .eyebrow {
    margin-bottom: 0.3rem;
  }
  .comment-stage-heading h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
  }
  [data-comment-list] {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }
  .comment-bubble {
    padding: 0.9rem 1rem;
    border: 1px solid rgba(76, 50, 35, 0.2);
    border-radius: 2px 12px 12px 12px;
    color: #413129;
    background: #fffaf2;
    box-shadow: 5px 7px 14px rgba(62, 38, 25, 0.13);
    transform: rotate(var(--bubble-tilt));
  }
  .comment-bubble::after {
    content: "";
    position: absolute;
    bottom: -9px;
    left: 14px;
    width: 16px;
    height: 16px;
    border-right: 1px solid rgba(76, 50, 35, 0.2);
    border-bottom: 1px solid rgba(76, 50, 35, 0.2);
    background: inherit;
    transform: rotate(45deg);
  }
  .comment-bubble strong,
  .comment-bubble p {
    position: relative;
    z-index: 1;
  }
  .comment-bubble strong {
    display: block;
    color: var(--plum);
    font-size: 0.72rem;
  }
  .comment-bubble p {
    display: -webkit-box;
    margin: 0.25rem 0 0;
    overflow: hidden;
    font: 1rem/1.32 var(--serif);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }
  .comment-bubble:nth-child(1) {
    --bubble-tilt: -1deg;
  }
  .comment-bubble:nth-child(2) {
    --bubble-tilt: 1deg;
  }
  .comment-bubble:nth-child(3) {
    --bubble-tilt: 0.6deg;
  }
  .comment-bubble:nth-child(4) {
    --bubble-tilt: -0.6deg;
  }
  .comment-bubble:nth-child(5) {
    --bubble-tilt: 1.2deg;
  }
  .comment-bubble:nth-child(6) {
    --bubble-tilt: -1.2deg;
  }
  .comment-empty {
    grid-column: 1 / -1;
    margin: 0.5rem 0;
    color: var(--muted);
    font: italic 1.05rem var(--serif);
    text-align: left;
  }
  .comment-overflow {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.72rem;
  }
  .comment-stage > .button {
    margin-top: 1.2rem;
  }
  .comment-dialog {
    width: min(32rem, calc(100% - 2rem));
    padding: 2rem;
    border: 0;
    color: var(--ink);
    background: var(--paper);
    box-shadow: 0 24px 70px rgba(31, 23, 20, 0.35);
  }
  .comment-dialog::backdrop {
    background: rgba(31, 23, 20, 0.62);
    backdrop-filter: blur(2px);
  }
  .comment-dialog [data-comment-form] {
    padding: 1.25rem;
    display: grid;
    gap: 1rem;
    border: 1px solid rgba(91, 48, 67, 0.32);
    background: rgba(255, 253, 247, 0.97);
  }
  .comment-dialog .dialog-close-row {
    z-index: 1;
    top: 3rem;
    right: 3rem;
  }
  .comment-dialog .icon-button {
    color: var(--ink);
    background: #fffdf8;
    box-shadow: 0 3px 10px rgba(60, 40, 28, 0.1);
  }
  .comment-dialog h3 {
    margin: 0;
    padding-right: 3rem;
    font-size: 1.8rem;
  }
  .comment-dialog form > p {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .comment-dialog label:not(.honeypot) {
    display: grid;
    gap: 0.35rem;
  }
  .comment-dialog textarea:focus-visible,
  .comment-dialog input:focus-visible {
    outline: 2px solid var(--plum);
    outline-offset: 2px;
  }
  .comment-dialog [data-turnstile] {
    min-height: 65px;
    display: flex;
    align-items: center;
  }
  .comment-dialog .button {
    justify-self: center;
  }
  .character-count {
    display: block;
    margin-top: 0.35rem;
    color: var(--muted);
    text-align: right;
    font-size: 0.72rem;
  }
  .honeypot {
    position: absolute;
    left: -9999px;
  }
  @media (max-width: 700px) {
    [data-comment-list] {
      grid-template-columns: 1fr;
    }
    .comment-bubble p {
      font-size: 0.9rem;
      -webkit-line-clamp: 3;
    }
    .comment-dialog {
      width: min(100% - 1rem, 32rem);
      padding: 1rem;
    }
    .comment-dialog .dialog-close-row {
      top: 2rem;
      right: 2rem;
    }
  }
</style>
