---
import { getBookAppearance, type Work } from "@mums-bookshelf/shared";

interface Props {
  works: Work[];
  compact?: boolean;
  recentWorkSlugs?: string[];
}

const { works, compact = false, recentWorkSlugs = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const featuredWork = works.find((work) => work.featured);
---

<section
  class:list={["bookshelf-wrap", { compact }]}
  aria-labelledby="bookshelf-title"
  data-bookshelf
>
  <div class="section-heading">
    <div>
      <p class="eyebrow">Denise's bookshelf</p>
      <h2 id="bookshelf-title">Pull out a story</h2>
      <p class="shelf-instruction">
        Choose a spine and settle in at the reading desk.
      </p>
    </div>
    <button class="text-button" type="button" data-skip-animation hidden
      >Skip reveal</button
    >
  </div>
  {
    works.length ? (
      <div
        class="bookcase"
        data-bookcase
        aria-label={`${works.length} published works on the bookshelf`}
      >
        <div data-featured-note>
          {featuredWork && (
            <a
              class="featured-note"
              href={`${base}works/${featuredWork.slug}/`}
            >
              <span>Featured story</span>
              <strong>{featuredWork.title}</strong>
              <small>Start here →</small>
            </a>
          )}
        </div>
        <div class="webgl-bookshelf" data-webgl-bookshelf aria-hidden="true">
          <canvas data-bookshelf-canvas />
          <p class="webgl-bookshelf-hint">
            Select a book to pull it from the shelf.
          </p>
        </div>
        <ol class="shelves shelf-fallback" data-shelf-list>
          {works.map((work, index) => {
            const appearance = getBookAppearance(work.id || work.slug);
            const style = [
              `--book-color:${appearance.primaryColor}`,
              `--book-accent:${appearance.accentColor}`,
              `--book-height:${appearance.height}px`,
              `--book-width:${appearance.width}px`,
              `--book-depth:${appearance.depth}px`,
              `--book-lean:${appearance.lean}deg`,
              `--book-radius:${appearance.borderRadius}px`,
              `--book-index:${index}`,
            ].join(";");
            return (
              <li
                class:list={[
                  "book-slot",
                  { "is-recent-release": recentWorkSlugs.includes(work.slug) },
                ]}
                data-featured={String(work.featured)}
                data-order-key={work.id}
                data-work-id={work.id}
                data-work-slug={work.slug}
                data-recent={String(recentWorkSlugs.includes(work.slug))}
              >
                <a
                  class:list={[
                    "book",
                    `spine-${appearance.spineStyle}`,
                    `material-${appearance.materialStyle}`,
                    `title-${appearance.titlePosition}`,
                  ]}
                  style={style}
                  href={`${base}works/${work.slug}/`}
                  aria-label={`${work.title}, ${work.publicationType.replace("-", " ")}`}
                  data-title={work.title.toLowerCase()}
                  data-book-title={work.title}
                  data-type={work.publicationType}
                  data-genres={work.genres.join(" ").toLowerCase()}
                  data-book-color={appearance.primaryColor}
                >
                  <span class="book-shine" aria-hidden="true" />
                  <span class="book-title">{work.title}</span>
                  <span class="book-mark" aria-hidden="true">
                    {appearance.mark}
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </div>
    ) : (
      <div class="empty-shelf">
        <p>The shelf is waiting for its first story.</p>
      </div>
    )
  }
  <details class="accessible-library">
    <summary>View as an accessible list</summary>
    <ul data-accessible-list>
      {
        works.map((work) => (
          <li data-featured={String(work.featured)} data-order-key={work.id}>
            <a href={`${base}works/${work.slug}/`}>{work.title}</a>
            <span>{work.publicationType.replace("-", " ")}</span>
          </li>
        ))
      }
    </ul>
  </details>
</section>

<script>
  import { getBookAppearance, type Work } from "@mums-bookshelf/shared";
  import { BookshelfBuilder } from "../lib/bookshelf/BookshelfBuilder";
  import { dailyFeaturedOrder } from "../lib/randomiseWorks";
  import { getRuntimePublicWorks } from "../lib/runtimeContent";

  const shelf = document.querySelector<HTMLElement>("[data-bookshelf]");
  const bookcase = shelf?.querySelector<HTMLElement>("[data-bookcase]");
  const shelfList = shelf?.querySelector<HTMLOListElement>("[data-shelf-list]");
  const accessibleList = shelf?.querySelector<HTMLUListElement>(
    "[data-accessible-list]",
  );
  const featuredNote = shelf?.querySelector<HTMLElement>(
    "[data-featured-note]",
  );
  const webglShelf = shelf?.querySelector<HTMLElement>(
    "[data-webgl-bookshelf]",
  );
  const canvas = shelf?.querySelector<HTMLCanvasElement>(
    "[data-bookshelf-canvas]",
  );
  const hint = shelf?.querySelector<HTMLElement>(".webgl-bookshelf-hint");
  const base = import.meta.env.BASE_URL;
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  let disposeWebglShelf: (() => void) | undefined;

  const workUrl = (slug: string) => `${base}works/${slug}/`;
  const orderShelf = () => {
    if (!shelfList || !accessibleList) return;
    dailyFeaturedOrder(
      [...shelfList.querySelectorAll<HTMLElement>(".book-slot")],
      (item) => item.dataset.featured === "true",
      (item) => item.dataset.orderKey || "",
    ).forEach((item) => shelfList.append(item));
    dailyFeaturedOrder(
      [...accessibleList.querySelectorAll<HTMLElement>("li")],
      (item) => item.dataset.featured === "true",
      (item) => item.dataset.orderKey || "",
    ).forEach((item) => accessibleList.append(item));
  };

  const bindFallbackOpening = () => {
    shelfList?.querySelectorAll<HTMLAnchorElement>(".book").forEach((book) => {
      book.addEventListener("click", (event) => {
        if (
          reduceMotion ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        )
          return;
        event.preventDefault();
        book.classList.add("is-opening");
        window.setTimeout(() => window.location.assign(book.href), 180);
      });
    });
  };

  const renderWebglShelf = () => {
    disposeWebglShelf?.();
    if (!canvas || !webglShelf || !shelfList || reduceMotion) return false;

    const bookshelf = new BookshelfBuilder({
      canvas,
      container: webglShelf,
      ...(hint ? { hint } : {}),
      links: [...shelfList.querySelectorAll<HTMLAnchorElement>(".book")],
    });
    bookshelf.start();
    shelf?.classList.add("has-webgl-bookshelf");
    disposeWebglShelf = () => bookshelf.dispose();
    return true;
  };

  const renderShelf = (publishedWorks: Work[]) => {
    if (!shelfList || !accessibleList || !bookcase || !featuredNote) return;
    const recentSlugs = [...publishedWorks]
      .sort(
        (left, right) =>
          Date.parse(right.publishedAt || "") -
          Date.parse(left.publishedAt || ""),
      )
      .slice(0, 1)
      .map((work) => work.slug);
    const fragment = document.createDocumentFragment();
    const accessibleFragment = document.createDocumentFragment();
    publishedWorks.forEach((work, index) => {
      const appearance = getBookAppearance(work.id || work.slug);
      const slot = document.createElement("li");
      slot.className = "book-slot";
      slot.dataset.featured = String(work.featured);
      slot.dataset.orderKey = work.id;
      slot.dataset.workId = work.id;
      slot.dataset.workSlug = work.slug;
      slot.dataset.recent = String(recentSlugs.includes(work.slug));
      if (recentSlugs.includes(work.slug))
        slot.classList.add("is-recent-release");

      const book = document.createElement("a");
      book.className = [
        "book",
        `spine-${appearance.spineStyle}`,
        `material-${appearance.materialStyle}`,
        `title-${appearance.titlePosition}`,
      ].join(" ");
      book.href = workUrl(work.slug);
      book.setAttribute(
        "aria-label",
        `${work.title}, ${work.publicationType.replace("-", " ")}`,
      );
      book.dataset.bookColor = appearance.primaryColor;
      book.dataset.bookTitle = work.title;
      const styleVariables: [string, string][] = [
        ["--book-color", appearance.primaryColor],
        ["--book-accent", appearance.accentColor],
        ["--book-height", `${appearance.height}px`],
        ["--book-width", `${appearance.width}px`],
        ["--book-depth", `${appearance.depth}px`],
        ["--book-lean", `${appearance.lean}deg`],
        ["--book-radius", `${appearance.borderRadius}px`],
        ["--book-index", String(index)],
      ];
      styleVariables.forEach(([property, value]) =>
        book.style.setProperty(property, value),
      );

      const shine = document.createElement("span");
      shine.className = "book-shine";
      shine.setAttribute("aria-hidden", "true");
      const title = document.createElement("span");
      title.className = "book-title";
      title.textContent = work.title;
      const mark = document.createElement("span");
      mark.className = "book-mark";
      mark.setAttribute("aria-hidden", "true");
      mark.textContent = appearance.mark;
      book.append(shine, title, mark);
      slot.append(book);
      fragment.append(slot);

      const item = document.createElement("li");
      item.dataset.featured = String(work.featured);
      item.dataset.orderKey = work.id;
      const link = document.createElement("a");
      link.href = workUrl(work.slug);
      link.textContent = work.title;
      const type = document.createElement("span");
      type.textContent = work.publicationType.replace("-", " ");
      item.append(link, type);
      accessibleFragment.append(item);
    });
    shelfList.replaceChildren(fragment);
    accessibleList.replaceChildren(accessibleFragment);
    bookcase.setAttribute(
      "aria-label",
      `${publishedWorks.length} published works on the bookshelf`,
    );
    featuredNote.replaceChildren();
    const featured = publishedWorks.find((work) => work.featured);
    if (featured) {
      const link = document.createElement("a");
      link.className = "featured-note";
      link.href = workUrl(featured.slug);
      ["Featured story", featured.title, "Start here →"].forEach(
        (text, index) => {
          const element = document.createElement(
            index === 1 ? "strong" : index === 2 ? "small" : "span",
          );
          element.textContent = text;
          link.append(element);
        },
      );
      featuredNote.append(link);
    }
    orderShelf();
    if (!renderWebglShelf()) bindFallbackOpening();
  };

  orderShelf();
  if (!renderWebglShelf()) bindFallbackOpening();
  void getRuntimePublicWorks()
    .then(renderShelf)
    .catch(() => undefined);
</script>
