---
import { getBookAppearance, type Work } from "@mums-bookshelf/shared";

interface Props {
  works: Work[];
  compact?: boolean;
  recentWorkSlugs?: string[];
}

const { works, compact = false, recentWorkSlugs = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const featuredWork = works.find((work) => work.featured);
---

<section
  class:list={["bookshelf-wrap", { compact }]}
  aria-labelledby="bookshelf-title"
  data-bookshelf
>
  <div class="section-heading">
    <div>
      <p class="eyebrow">Denise's bookshelf</p>
      <h2 id="bookshelf-title">Pull out a story</h2>
      <p class="shelf-instruction">
        Choose a spine and settle in at the reading desk.
      </p>
    </div>
    <button class="text-button" type="button" data-skip-animation hidden
      >Skip reveal</button
    >
  </div>
  {
    works.length ? (
      <div
        class="bookcase"
        data-bookcase
        aria-label={`${works.length} published works on the bookshelf`}
      >
        <div data-featured-note>
          {featuredWork && (
            <a
              class="featured-note"
              href={`${base}works/${featuredWork.slug}/`}
            >
              <span>Featured story</span>
              <strong>{featuredWork.title}</strong>
              <small>Start here →</small>
            </a>
          )}
        </div>
        <div class="webgl-bookshelf" data-webgl-bookshelf aria-hidden="true">
          <canvas data-bookshelf-canvas />
          <p class="webgl-bookshelf-hint">
            Select a book to pull it from the shelf. Drag it to turn the cover.
          </p>
        </div>
        <ol class="shelves shelf-fallback" data-shelf-list>
          {works.map((work, index) => {
            const appearance = getBookAppearance(work.id || work.slug);
            const style = [
              `--book-color:${appearance.primaryColor}`,
              `--book-accent:${appearance.accentColor}`,
              `--book-height:${appearance.height}px`,
              `--book-width:${appearance.width}px`,
              `--book-depth:${appearance.depth}px`,
              `--book-lean:${appearance.lean}deg`,
              `--book-radius:${appearance.borderRadius}px`,
              `--book-index:${index}`,
            ].join(";");
            return (
              <li
                class:list={[
                  "book-slot",
                  { "is-recent-release": recentWorkSlugs.includes(work.slug) },
                ]}
                data-featured={String(work.featured)}
                data-order-key={work.id}
                data-work-id={work.id}
                data-work-slug={work.slug}
                data-recent={String(recentWorkSlugs.includes(work.slug))}
              >
                <a
                  class:list={[
                    "book",
                    `spine-${appearance.spineStyle}`,
                    `material-${appearance.materialStyle}`,
                    `title-${appearance.titlePosition}`,
                  ]}
                  style={style}
                  href={`${base}works/${work.slug}/`}
                  aria-label={`${work.title}, ${work.publicationType.replace("-", " ")}`}
                  data-title={work.title.toLowerCase()}
                  data-book-title={work.title}
                  data-type={work.publicationType}
                  data-genres={work.genres.join(" ").toLowerCase()}
                  data-book-color={appearance.primaryColor}
                >
                  <span class="book-shine" aria-hidden="true" />
                  <span class="book-title">{work.title}</span>
                  <span class="book-mark" aria-hidden="true">
                    {appearance.mark}
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </div>
    ) : (
      <div class="empty-shelf">
        <p>The shelf is waiting for its first story.</p>
      </div>
    )
  }
  <details class="accessible-library">
    <summary>View as an accessible list</summary>
    <ul data-accessible-list>
      {
        works.map((work) => (
          <li data-featured={String(work.featured)} data-order-key={work.id}>
            <a href={`${base}works/${work.slug}/`}>{work.title}</a>
            <span>{work.publicationType.replace("-", " ")}</span>
          </li>
        ))
      }
    </ul>
  </details>
</section>

<script>
  import { getBookAppearance, type Work } from "@mums-bookshelf/shared";
  import * as THREE from "three";
  import { dailyFeaturedOrder } from "../lib/randomiseWorks";
  import { getRuntimePublicWorks } from "../lib/runtimeContent";

  const shelf = document.querySelector<HTMLElement>("[data-bookshelf]");
  const bookcase = shelf?.querySelector<HTMLElement>("[data-bookcase]");
  const shelfList = shelf?.querySelector<HTMLOListElement>("[data-shelf-list]");
  const accessibleList = shelf?.querySelector<HTMLUListElement>(
    "[data-accessible-list]",
  );
  const featuredNote = shelf?.querySelector<HTMLElement>(
    "[data-featured-note]",
  );
  const webglShelf = shelf?.querySelector<HTMLElement>(
    "[data-webgl-bookshelf]",
  );
  const canvas = shelf?.querySelector<HTMLCanvasElement>(
    "[data-bookshelf-canvas]",
  );
  const hint = shelf?.querySelector<HTMLElement>(".webgl-bookshelf-hint");
  const base = import.meta.env.BASE_URL;
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  let disposeWebglShelf: (() => void) | undefined;

  const workUrl = (slug: string) => `${base}works/${slug}/`;
  const orderShelf = () => {
    if (!shelfList || !accessibleList) return;
    dailyFeaturedOrder(
      [...shelfList.querySelectorAll<HTMLElement>(".book-slot")],
      (item) => item.dataset.featured === "true",
      (item) => item.dataset.orderKey || "",
    ).forEach((item) => shelfList.append(item));
    dailyFeaturedOrder(
      [...accessibleList.querySelectorAll<HTMLElement>("li")],
      (item) => item.dataset.featured === "true",
      (item) => item.dataset.orderKey || "",
    ).forEach((item) => accessibleList.append(item));
  };

  type ShelfBook = {
    root: THREE.Group;
    frontCover: THREE.Group;
    backCover: THREE.Group;
    home: THREE.Vector3;
    homeLean: number;
    width: number;
    height: number;
    url: string;
    open: number;
    turn: number;
    hover: number;
  };

  const bindFallbackOpening = () => {
    shelfList?.querySelectorAll<HTMLAnchorElement>(".book").forEach((book) => {
      book.addEventListener("click", (event) => {
        if (
          reduceMotion ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        )
          return;
        event.preventDefault();
        book.classList.add("is-opening");
        window.setTimeout(() => window.location.assign(book.href), 180);
      });
    });
  };

  const makeTitleTexture = (
    title: string,
    mark: string,
    accent: string,
    style: string,
  ) => {
    const textureCanvas = document.createElement("canvas");
    textureCanvas.width = 512;
    textureCanvas.height = 768;
    const context = textureCanvas.getContext("2d");
    if (!context) return new THREE.CanvasTexture(textureCanvas);
    context.clearRect(0, 0, textureCanvas.width, textureCanvas.height);
    context.strokeStyle = accent;
    context.globalAlpha = 0.8;
    context.lineWidth = 5;
    if (style === "bands") {
      [82, 684].forEach((y) => context.strokeRect(55, y, 402, 24));
    } else if (style === "frame") {
      context.strokeRect(44, 44, 424, 680);
    } else if (style === "rule") {
      context.beginPath();
      context.moveTo(92, 58);
      context.lineTo(92, 710);
      context.stroke();
    }
    context.globalAlpha = 1;
    context.fillStyle = accent;
    context.textAlign = "center";
    context.font = "46px Georgia, serif";
    context.fillText(mark, 256, 135);
    context.font = "600 32px Georgia, serif";
    const words = title.split(/\s+/);
    const lines: string[] = [];
    let line = "";
    words.forEach((word) => {
      const candidate = line ? `${line} ${word}` : word;
      if (context.measureText(candidate).width > 340 && line) {
        lines.push(line);
        line = word;
      } else {
        line = candidate;
      }
    });
    if (line) lines.push(line);
    const lineStart = 382 - ((lines.length - 1) * 42) / 2;
    lines.forEach((text, index) =>
      context.fillText(text, 256, lineStart + index * 42),
    );
    const texture = new THREE.CanvasTexture(textureCanvas);
    texture.colorSpace = THREE.SRGBColorSpace;
    return texture;
  };

  const renderWebglShelf = () => {
    disposeWebglShelf?.();
    if (!canvas || !webglShelf || !shelfList || reduceMotion) return false;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFShadowMap;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color("#482718");
    const camera = new THREE.PerspectiveCamera(33, 1, 0.1, 100);
    camera.position.set(0, 4.9, 12.8);
    camera.lookAt(0, 2.7, 0);
    const warmLight = new THREE.SpotLight(
      "#ffe2ad",
      260,
      30,
      Math.PI / 5,
      0.7,
      1.5,
    );
    warmLight.position.set(-5, 9, 8);
    warmLight.castShadow = true;
    warmLight.shadow.mapSize.set(1024, 1024);
    scene.add(warmLight, new THREE.HemisphereLight("#f7dbad", "#25130c", 2.4));

    const shelfWidth = 15;
    const shelfPadding = 0.65;
    const shelfSpacing = 3.55;
    const boardThickness = 0.28;
    const links = [...shelfList.querySelectorAll<HTMLAnchorElement>(".book")];
    type ShelfLayout = {
      link: HTMLAnchorElement;
      appearance: ReturnType<typeof getBookAppearance>;
      width: number;
      height: number;
      depth: number;
    };
    const shelfRows: ShelfLayout[][] = [[]];
    const shelfCapacity = shelfWidth - shelfPadding * 2;
    let rowWidth = 0;
    links.forEach((link) => {
      const appearance = getBookAppearance(
        link.closest<HTMLElement>(".book-slot")?.dataset.workId ||
          link.dataset.title ||
          "book",
      );
      const layout = {
        link,
        appearance,
        width: appearance.width / 46,
        height: appearance.height / 78,
        depth: 0.42 + appearance.depth / 95,
      };
      const gap = rowWidth ? 0.08 : 0;
      if (rowWidth && rowWidth + gap + layout.width > shelfCapacity) {
        shelfRows.push([]);
        rowWidth = 0;
      }
      shelfRows.at(-1)!.push(layout);
      rowWidth += (rowWidth ? 0.08 : 0) + layout.width;
    });
    const shelfHeights = shelfRows.map(
      (_, index) => 0.25 + index * shelfSpacing,
    );
    const cabinetHeight = Math.max(7.2, shelfRows.length * shelfSpacing + 0.25);
    const updateShelfViewportHeight = () => {
      const baseHeight = window.matchMedia("(max-width: 640px)").matches
        ? 390
        : 530;
      webglShelf.style.setProperty(
        "--webgl-shelf-height",
        `${baseHeight + (shelfRows.length - 1) * 245}px`,
      );
    };
    updateShelfViewportHeight();
    camera.position.set(
      0,
      cabinetHeight / 2 + 1.2,
      12.8 + Math.max(0, shelfRows.length - 2) * 2.2,
    );
    camera.lookAt(0, cabinetHeight / 2, 0);
    const wood = new THREE.MeshStandardMaterial({
      color: "#5a301d",
      roughness: 0.62,
      metalness: 0.03,
    });
    const woodEdge = new THREE.MeshStandardMaterial({
      color: "#32170e",
      roughness: 0.72,
    });
    const back = new THREE.Mesh(
      new THREE.BoxGeometry(shelfWidth, cabinetHeight, 0.42),
      wood,
    );
    back.position.set(0, cabinetHeight / 2, -0.72);
    back.receiveShadow = true;
    scene.add(back);
    [-shelfWidth / 2 + 0.22, shelfWidth / 2 - 0.22].forEach((x) => {
      const side = new THREE.Mesh(
        new THREE.BoxGeometry(0.45, cabinetHeight + 0.5, 1.3),
        woodEdge,
      );
      side.position.set(x, cabinetHeight / 2, 0);
      side.castShadow = true;
      scene.add(side);
    });

    const books: ShelfBook[] = [];
    shelfRows.forEach((shelfRow, row) => {
      const rowBookWidth = shelfRow.reduce(
        (total, book, index) => total + book.width + (index ? 0.08 : 0),
        0,
      );
      let cursor = -rowBookWidth / 2;
      shelfRow.forEach(({ link, appearance, width, height, depth }) => {
        const root = new THREE.Group();
        const frontCover = new THREE.Group();
        const backCover = new THREE.Group();
        const coverThickness = 0.11;
        const pageDepth = Math.max(0.16, depth - coverThickness * 2);
        const bookMaterial = new THREE.MeshStandardMaterial({
          color: appearance.primaryColor,
          roughness: appearance.materialStyle === "leather" ? 0.38 : 0.68,
          metalness: 0.03,
        });
        const pageMaterial = new THREE.MeshStandardMaterial({
          color: "#eadfc9",
          roughness: 0.9,
        });
        const pages = new THREE.Mesh(
          new THREE.BoxGeometry(width - 0.12, height - 0.14, pageDepth),
          pageMaterial,
        );
        pages.castShadow = true;
        root.add(pages);

        // Both covers hinge at the spine, which keeps the page block enclosed.
        frontCover.position.x = -width / 2;
        const front = new THREE.Mesh(
          new THREE.BoxGeometry(width, height, coverThickness),
          bookMaterial,
        );
        front.position.set(width / 2, 0, pageDepth / 2 + coverThickness / 2);
        front.castShadow = true;
        frontCover.add(front);
        backCover.position.x = -width / 2;
        const rear = new THREE.Mesh(
          new THREE.BoxGeometry(width, height, coverThickness),
          bookMaterial,
        );
        rear.position.set(width / 2, 0, -(pageDepth / 2 + coverThickness / 2));
        rear.castShadow = true;
        backCover.add(rear);
        const spine = new THREE.Mesh(
          new THREE.BoxGeometry(coverThickness, height, depth),
          bookMaterial,
        );
        spine.position.x = -width / 2;
        spine.castShadow = true;
        root.add(frontCover, backCover, spine);
        const titleTexture = makeTitleTexture(
          link.dataset.bookTitle || link.dataset.title || "",
          appearance.mark,
          appearance.accentColor,
          appearance.spineStyle,
        );
        const title = new THREE.Mesh(
          new THREE.PlaneGeometry(width * 0.79, height * 0.74),
          new THREE.MeshBasicMaterial({
            map: titleTexture,
            transparent: true,
            depthWrite: false,
          }),
        );
        title.position.z = pageDepth / 2 + coverThickness + 0.006;
        root.add(title);
        const home = new THREE.Vector3(
          cursor + width / 2,
          shelfHeights[row]! +
            boardThickness / 2 +
            height / 2 +
            Math.abs(
              Math.sin(THREE.MathUtils.degToRad(appearance.lean)) * width * 0.5,
            ) +
            0.025,
          0.2,
        );
        root.position.copy(home);
        root.rotation.z = THREE.MathUtils.degToRad(appearance.lean);
        const book: ShelfBook = {
          root,
          frontCover,
          backCover,
          home,
          homeLean: root.rotation.z,
          width,
          height,
          url: link.href,
          open: 0,
          turn: 0,
          hover: 0,
        };
        root.userData.shelfBook = book;
        scene.add(root);
        books.push(book);
        cursor += width + 0.08;
      });
    });
    shelfHeights.forEach((height) => {
      const board = new THREE.Mesh(
        new THREE.BoxGeometry(shelfWidth - 0.42, boardThickness, 1.45),
        woodEdge,
      );
      board.position.set(0, height, -0.05);
      board.receiveShadow = true;
      board.castShadow = true;
      scene.add(board);
    });

    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();
    let selected: ShelfBook | undefined;
    let hovered: ShelfBook | undefined;
    let pointerDown: { x: number; y: number } | undefined;
    let isDragging = false;
    let frame = 0;
    const findBook = (object: THREE.Object3D | null) => {
      let current = object;
      while (current) {
        if (current.userData.shelfBook)
          return current.userData.shelfBook as ShelfBook;
        current = current.parent;
      }
    };
    const bookAt = (event: PointerEvent) => {
      const bounds = canvas.getBoundingClientRect();
      pointer.set(
        ((event.clientX - bounds.left) / bounds.width) * 2 - 1,
        -((event.clientY - bounds.top) / bounds.height) * 2 + 1,
      );
      raycaster.setFromCamera(pointer, camera);
      return findBook(
        raycaster.intersectObjects(scene.children, true)[0]?.object ?? null,
      );
    };
    const select = (book: ShelfBook) => {
      selected = book;
      books.forEach((candidate) => {
        candidate.open = candidate === book ? 1 : 0;
      });
      if (hint)
        hint.textContent =
          "Drag the open book to turn it. Select it again to begin reading.";
    };
    const onPointerDown = (event: PointerEvent) => {
      pointerDown = { x: event.clientX, y: event.clientY };
      isDragging = false;
      canvas.setPointerCapture(event.pointerId);
    };
    const onPointerMove = (event: PointerEvent) => {
      const book = bookAt(event);
      hovered = book;
      canvas.style.cursor = book ? "grab" : "default";
      if (!pointerDown || !selected) return;
      const dx = event.clientX - pointerDown.x;
      const dy = event.clientY - pointerDown.y;
      if (Math.abs(dx) + Math.abs(dy) > 5) {
        isDragging = true;
        selected.turn = THREE.MathUtils.clamp(
          selected.turn + dx * 0.008,
          -1.05,
          1.05,
        );
        selected.root.rotation.x = THREE.MathUtils.clamp(
          selected.root.rotation.x + dy * 0.004,
          -0.65,
          0.35,
        );
        pointerDown = { x: event.clientX, y: event.clientY };
      }
    };
    const onPointerLeave = () => {
      hovered = undefined;
      canvas.style.cursor = "default";
    };
    const onPointerUp = (event: PointerEvent) => {
      const book = bookAt(event);
      if (!isDragging && book) {
        if (book === selected) window.location.assign(book.url);
        else select(book);
      }
      pointerDown = undefined;
    };
    const resize = () => {
      updateShelfViewportHeight();
      const { width, height } = webglShelf.getBoundingClientRect();
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    };
    const animate = () => {
      frame = window.requestAnimationFrame(animate);
      books.forEach((book) => {
        book.hover = THREE.MathUtils.lerp(
          book.hover,
          book === hovered && !book.open ? 1 : 0,
          0.16,
        );
        const target = book.open
          ? new THREE.Vector3(0, 3.25, 2.65)
          : book.home
              .clone()
              .add(new THREE.Vector3(0, book.hover * 0.24, book.hover * 0.18));
        book.root.position.lerp(target, 0.11);
        book.root.rotation.y = THREE.MathUtils.lerp(
          book.root.rotation.y,
          book.open ? book.turn : 0,
          0.1,
        );
        book.root.rotation.z = THREE.MathUtils.lerp(
          book.root.rotation.z,
          book.open ? -0.06 : book.homeLean,
          0.1,
        );
        if (!book.open)
          book.root.rotation.x = THREE.MathUtils.lerp(
            book.root.rotation.x,
            0,
            0.1,
          );
        book.frontCover.rotation.y = THREE.MathUtils.lerp(
          book.frontCover.rotation.y,
          book.open ? -1.18 : 0,
          0.1,
        );
        book.backCover.rotation.y = THREE.MathUtils.lerp(
          book.backCover.rotation.y,
          book.open ? 1.18 : 0,
          0.1,
        );
      });
      renderer.render(scene, camera);
    };
    const observer = new ResizeObserver(resize);
    observer.observe(webglShelf);
    canvas.addEventListener("pointerdown", onPointerDown);
    canvas.addEventListener("pointermove", onPointerMove);
    canvas.addEventListener("pointerup", onPointerUp);
    canvas.addEventListener("pointerleave", onPointerLeave);
    resize();
    animate();
    shelf?.classList.add("has-webgl-bookshelf");
    disposeWebglShelf = () => {
      window.cancelAnimationFrame(frame);
      observer.disconnect();
      canvas.removeEventListener("pointerdown", onPointerDown);
      canvas.removeEventListener("pointermove", onPointerMove);
      canvas.removeEventListener("pointerup", onPointerUp);
      canvas.removeEventListener("pointerleave", onPointerLeave);
      scene.traverse((object) => {
        const mesh = object as THREE.Mesh;
        mesh.geometry?.dispose();
        const materials = Array.isArray(mesh.material)
          ? mesh.material
          : [mesh.material];
        materials.forEach((material) => {
          const texturedMaterial = material as THREE.Material & {
            map?: THREE.Texture;
          };
          texturedMaterial.map?.dispose();
          material.dispose();
        });
      });
      renderer.dispose();
    };
    return true;
  };

  const renderShelf = (publishedWorks: Work[]) => {
    if (!shelfList || !accessibleList || !bookcase || !featuredNote) return;
    const recentSlugs = [...publishedWorks]
      .sort(
        (left, right) =>
          Date.parse(right.publishedAt || "") -
          Date.parse(left.publishedAt || ""),
      )
      .slice(0, 1)
      .map((work) => work.slug);
    const fragment = document.createDocumentFragment();
    const accessibleFragment = document.createDocumentFragment();
    publishedWorks.forEach((work, index) => {
      const appearance = getBookAppearance(work.id || work.slug);
      const slot = document.createElement("li");
      slot.className = "book-slot";
      slot.dataset.featured = String(work.featured);
      slot.dataset.orderKey = work.id;
      slot.dataset.workId = work.id;
      slot.dataset.workSlug = work.slug;
      slot.dataset.recent = String(recentSlugs.includes(work.slug));
      if (recentSlugs.includes(work.slug))
        slot.classList.add("is-recent-release");

      const book = document.createElement("a");
      book.className = [
        "book",
        `spine-${appearance.spineStyle}`,
        `material-${appearance.materialStyle}`,
        `title-${appearance.titlePosition}`,
      ].join(" ");
      book.href = workUrl(work.slug);
      book.setAttribute(
        "aria-label",
        `${work.title}, ${work.publicationType.replace("-", " ")}`,
      );
      book.dataset.bookColor = appearance.primaryColor;
      book.dataset.bookTitle = work.title;
      const styleVariables: [string, string][] = [
        ["--book-color", appearance.primaryColor],
        ["--book-accent", appearance.accentColor],
        ["--book-height", `${appearance.height}px`],
        ["--book-width", `${appearance.width}px`],
        ["--book-depth", `${appearance.depth}px`],
        ["--book-lean", `${appearance.lean}deg`],
        ["--book-radius", `${appearance.borderRadius}px`],
        ["--book-index", String(index)],
      ];
      styleVariables.forEach(([property, value]) =>
        book.style.setProperty(property, value),
      );

      const shine = document.createElement("span");
      shine.className = "book-shine";
      shine.setAttribute("aria-hidden", "true");
      const title = document.createElement("span");
      title.className = "book-title";
      title.textContent = work.title;
      const mark = document.createElement("span");
      mark.className = "book-mark";
      mark.setAttribute("aria-hidden", "true");
      mark.textContent = appearance.mark;
      book.append(shine, title, mark);
      slot.append(book);
      fragment.append(slot);

      const item = document.createElement("li");
      item.dataset.featured = String(work.featured);
      item.dataset.orderKey = work.id;
      const link = document.createElement("a");
      link.href = workUrl(work.slug);
      link.textContent = work.title;
      const type = document.createElement("span");
      type.textContent = work.publicationType.replace("-", " ");
      item.append(link, type);
      accessibleFragment.append(item);
    });
    shelfList.replaceChildren(fragment);
    accessibleList.replaceChildren(accessibleFragment);
    bookcase.setAttribute(
      "aria-label",
      `${publishedWorks.length} published works on the bookshelf`,
    );
    featuredNote.replaceChildren();
    const featured = publishedWorks.find((work) => work.featured);
    if (featured) {
      const link = document.createElement("a");
      link.className = "featured-note";
      link.href = workUrl(featured.slug);
      ["Featured story", featured.title, "Start here →"].forEach(
        (text, index) => {
          const element = document.createElement(
            index === 1 ? "strong" : index === 2 ? "small" : "span",
          );
          element.textContent = text;
          link.append(element);
        },
      );
      featuredNote.append(link);
    }
    orderShelf();
    if (!renderWebglShelf()) bindFallbackOpening();
  };

  orderShelf();
  if (!renderWebglShelf()) bindFallbackOpening();
  void getRuntimePublicWorks()
    .then(renderShelf)
    .catch(() => undefined);
</script>
