---
import type { Work } from "@mums-bookshelf/shared";
import FallbackCover from "./FallbackCover.astro";

interface Props {
  work: Work;
  authorName: string;
}

const { work, authorName } = Astro.props;
const base = import.meta.env.BASE_URL;
const date = work.publishedAt
  ? new Intl.DateTimeFormat("en-NZ", { year: "numeric", month: "long" }).format(new Date(work.publishedAt))
  : "";
---

<article class="work-card" data-work-card data-title={work.title.toLowerCase()} data-type={work.publicationType} data-genres={work.genres.join(" ").toLowerCase()} data-featured={String(work.featured)}>
  <a class="work-card-cover" href={`${base}works/${work.slug}/`} tabindex="-1" aria-hidden="true">
    <FallbackCover title={work.title} seed={work.id} authorName={authorName} label={work.publicationType.replace("-", " ")} />
  </a>
  <div class="work-card-body">
    <p class="work-meta">{work.publicationType.replace("-", " ")} {date && <span>· {date}</span>}</p>
    <h2><a href={`${base}works/${work.slug}/`}>{work.title}</a></h2>
    <p>{work.blurb}</p>
    <div class="tag-row">
      {work.genres.slice(0, 2).map((genre) => <span>{genre}</span>)}
    </div>
  </div>
</article>
