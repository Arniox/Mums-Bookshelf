---
import { getBookAppearance } from "@mums-bookshelf/shared";

interface Props {
  title: string;
  seed: string;
  authorName: string;
  label?: string;
}

const {
  title,
  seed,
  authorName,
  label = `A work by ${authorName}`,
} = Astro.props;
const appearance = getBookAppearance(seed);
---

<div
  class="fallback-cover"
  style={`--cover:${appearance.primaryColor};--cover-accent:${appearance.accentColor}`}
  role="img"
  aria-label={`Decorative cover for ${title}`}
>
  <span class="cover-rule"></span>
  <p>{label}</p>
  <h2>{title}</h2>
  <span class="cover-ornament">✦</span>
  <small>{authorName}</small>
</div>
