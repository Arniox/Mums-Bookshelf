---
import type { PublicSettings } from "@mums-bookshelf/shared";
import { getPublicSettings } from "../lib/contentSource";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  siteSettings?: PublicSettings;
}

const {
  title,
  description,
  image,
  noindex = false,
  siteSettings: suppliedSettings,
} = Astro.props;
const settings = suppliedSettings || (await getPublicSettings());
const authorName = settings.authorName;
const [authorFirstName, ...authorRemainingNames] = authorName.split(/\s+/);
const authorRest = authorRemainingNames.join(" ");
const authorInitials = authorName
  .split(/\s+/)
  .map((name) => name[0])
  .filter(Boolean)
  .slice(0, 2)
  .join("")
  .toUpperCase();
const pageTitle = title || `${authorName} — Author`;
const pageDescription = description || settings.introduction;
const canonicalPath =
  Astro.url.pathname.endsWith("/") || /\.[^/]+$/.test(Astro.url.pathname)
    ? Astro.url.pathname
    : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, Astro.site);
const fullTitle = pageTitle.includes(authorName)
  ? pageTitle
  : `${pageTitle} — ${authorName}`;
const configuredBase = import.meta.env.BASE_URL;
const base = configuredBase.endsWith("/")
  ? configuredBase
  : `${configuredBase}/`;
const socialImage = image || `${base}denise-diehl-social-card-v2.png`;
const socialImageUrl = new URL(socialImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${authorName}'s latest work`}
      href={`${base}rss.xml`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={`${authorName}'s Bookshelf`} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta
      property="og:image:alt"
      content={`${authorName} — Stories for the quietly curious`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta
      name="twitter:image:alt"
      content={`${authorName} — Stories for the quietly curious`}
    />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a
        class="wordmark"
        href={base}
        aria-label={`${authorName}, home`}
        data-author-wordmark
      >
        <span>{authorFirstName}</span>{authorRest && ` ${authorRest}`}
      </a>
      <nav aria-label="Primary navigation">
        <a href={`${base}works/`}>Works</a>
        <a href={`${base}about/`}>About</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        <span class="footer-mark">{authorInitials}</span>
        <span data-author-introduction>{settings.introduction}</span>
      </p>
      <nav aria-label="Footer navigation">
        <a href={`${base}rss.xml`}>RSS</a>
        <a href={`${base}admin/`}>Author sign in</a>
      </nav>
      <p data-author-copyright>© {new Date().getFullYear()} {authorName}</p>
    </footer>
  </body>
</html>

<script>
  import { getRuntimePublicSettings } from "../lib/runtimeContent";

  const updateSharedAuthorDetails = (settings: {
    authorName: string;
    introduction: string;
  }) => {
    const wordmark = document.querySelector<HTMLElement>(
      "[data-author-wordmark]",
    );
    if (wordmark) {
      const [firstName, ...remainingNames] = settings.authorName.split(/\s+/);
      const firstNameElement = document.createElement("span");
      firstNameElement.textContent = firstName || settings.authorName;
      wordmark.replaceChildren(
        firstNameElement,
        remainingNames.length ? ` ${remainingNames.join(" ")}` : "",
      );
      wordmark.setAttribute("aria-label", `${settings.authorName}, home`);
    }
    document
      .querySelectorAll<HTMLElement>("[data-author-introduction]")
      .forEach((element) => {
        element.textContent = settings.introduction;
      });
    const copyright = document.querySelector<HTMLElement>(
      "[data-author-copyright]",
    );
    if (copyright)
      copyright.textContent = `© ${new Date().getFullYear()} ${settings.authorName}`;
  };

  void getRuntimePublicSettings()
    .then(updateSharedAuthorDetails)
    .catch(() => undefined);
</script>

<style is:global>
  @import "../styles/global.css";
</style>
