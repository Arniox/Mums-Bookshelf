{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "author-library-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://arniox.github.io",
    "AUTH_TOKEN_ISSUER": "author-library-api",
    "AUTH_ACCESS_TOKEN_TTL_SECONDS": "900",
    "AUTH_REFRESH_TOKEN_TTL_SECONDS": "2592000",
    "ENVIRONMENT": "production",
    "PUBLIC_COMMENTS_ENABLED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "author-library",
      "database_id": "2451d313-8648-4f54-b743-d120b47e2f5e",
      "migrations_dir": "migrations",
    },
  ],
}
