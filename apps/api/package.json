{
  "name": "@mums-bookshelf/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:migrate:local": "wrangler d1 migrations apply author-library --local",
    "db:seed:local": "wrangler d1 execute author-library --local --file migrations/0002_seed.sql",
    "deploy": "wrangler deploy",
    "clean": "rimraf dist .wrangler"
  },
  "dependencies": {
    "@mums-bookshelf/shared": "1.0.0",
    "hono": "^4.7.11",
    "jose": "^6.0.11",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/node": "^22.15.29",
    "@vitest/coverage-v8": "^3.2.4",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.19.1"
  }
}
