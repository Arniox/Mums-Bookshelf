{
  "name": "@mums-bookshelf/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:migrate:local": "wrangler d1 migrations apply author-library --local",
    "db:migrate:remote": "wrangler d1 migrations apply author-library --remote",
    "db:seed:local": "wrangler d1 execute author-library --local --file migrations/0002_seed.sql",
    "deploy": "wrangler deploy",
    "clean": "rimraf dist .wrangler"
  },
  "dependencies": {
    "@mums-bookshelf/shared": "1.0.0",
    "hono": "^4.13.2",
    "jose": "^6.2.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
